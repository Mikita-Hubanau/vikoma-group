# Настройки для боевого хостинга (hoster.by и любой другой Apache).
# GitHub Pages этот файл игнорирует — там всё работает и без него.

# Всегда открывать сайт по защищённому протоколу.
# Второе условие нужно там, где шифрование завершает nginx перед Apache
# (так устроен Fornex): без него получился бы бесконечный редирект.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Короткая ссылка для приглашений: vikub.com/zoom ведёт на регистрацию
  # семинара в Zoom. Тот же адрес доступен и одной буквой — vikub.com/z,
  # для случаев, где ссылку диктуют или набирают руками.
  # Редирект временный (302) — адрес семинара меняется,
  # и браузеры не должны запоминать его навсегда.
  RewriteRule ^(zoom|z)/?$ https://us06web.zoom.us/meeting/register/a_kUzWCXT3-X-Ko5CUPpUg [R=302,L,NE]
</IfModule>

# Заголовки безопасности. Директива Options здесь не используется намеренно:
# на этом хостинге она отключает исполнение PHP во всём каталоге.
<IfModule mod_headers.c>
  # не угадывать тип файла вопреки заявленному — закрывает часть XSS-трюков
  Header always set X-Content-Type-Options "nosniff"
  # чужим сайтам передаётся только домен-источник, но не полный адрес страницы
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # X-Frame-Options здесь не ставим: сервер Fornex уже отдаёт его сам,
  # а два одинаковых заголовка часть браузеров считает некорректными и игнорирует
  # камера, микрофон и геолокация сайту не нужны — отключаем на уровне браузера
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Своя страница «не найдено» вместо стандартной страницы хостинга
ErrorDocument 404 /404.html

# Сжатие текстовых файлов при передаче — страница приходит в разы легче
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Как долго браузер хранит файлы у себя, чтобы не качать их заново
<IfModule mod_expires.c>
  ExpiresActive On

  # Картинки, видео и шрифты: имена файлов со сборки не меняются просто так,
  # поэтому можно хранить долго
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/avif              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType video/mp4               "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"

  # Сами страницы — коротко: чтобы правки из CMS появлялись быстро
  ExpiresByType text/html               "access plus 10 minutes"
</IfModule>

# Правильная кодировка для русского и итальянского текста
AddDefaultCharset UTF-8
