# Настройки для боевого хостинга (hoster.by и любой другой Apache).
# GitHub Pages этот файл игнорирует — там всё работает и без него.

# Своя страница «не найдено» вместо стандартной страницы хостинга
ErrorDocument 404 /404.html

# Сжатие текстовых файлов при передаче — страница приходит в разы легче
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Как долго браузер хранит файлы у себя, чтобы не качать их заново
<IfModule mod_expires.c>
  ExpiresActive On

  # Картинки, видео и шрифты: имена файлов со сборки не меняются просто так,
  # поэтому можно хранить долго
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/avif              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType video/mp4               "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"

  # Сами страницы — коротко: чтобы правки из CMS появлялись быстро
  ExpiresByType text/html               "access plus 10 minutes"
</IfModule>

# Правильная кодировка для русского и итальянского текста
AddDefaultCharset UTF-8
