---
import { href } from '../lib/url';
import type { Locale } from '../i18n/config';
import type { RouteKey } from '../i18n/routes';
interface Props { locale: Locale; page: RouteKey; }
const { locale, page } = Astro.props;
const target = href(page, locale);
const canonical = new URL(target, Astro.site ?? Astro.url).toString();
const label = { it: 'Apri la pagina', en: 'Open the page', ru: 'Открыть страницу' }[locale];
---
<!doctype html><html lang={locale}><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex, follow" /><meta http-equiv="refresh" content={`0;url=${target}`} /><link rel="canonical" href={canonical} /><title>VIKUB</title></head><body><p><a href={target}>{label} — VIKUB</a></p></body></html>
