---
// РЕЖИМ ПРАВКИ.
//
// Включается ссылкой «Редактировать» в подвале (адрес с ?edit=1)
// и держится, пока вы ходите по сайту. Выключается там же.
//
// Пока режим включён, на блоках видны карандаши, которые открывают
// редактор сразу на нужной записи.
//
// Это единственный скрипт на страницах сайта — около 300 байт.
// Обычный посетитель ничего не видит и ничего лишнего не грузит.
---

<script is:inline>
  // Запоминаем режим на время сессии, чтобы карандаши не пропадали
  // при переходе на другую страницу.
  (() => {
    const p = new URLSearchParams(location.search);
    if (p.has('edit')) {
      if (p.get('edit') === '0') sessionStorage.removeItem('vg-edit');
      else sessionStorage.setItem('vg-edit', '1');
    }
    if (sessionStorage.getItem('vg-edit')) {
      document.documentElement.classList.add('edit-mode');
    }
  })();
</script>
