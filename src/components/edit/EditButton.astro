---
// Кнопка-карандаш на блоке.
//
// Открывает редактор сразу на нужной записи, а не на общем списке.
// Обычный посетитель её не видит: кнопки скрыты, пока не включён
// режим правки (адрес с ?edit).
//
// Сама кнопка — просто ссылка. Даже если кто-то её увидит, войти
// в редактор он не сможет: там нужен доступ к GitHub.
import { asset } from '../../lib/url';

interface Props {
  /** Раздел в редакторе: pages, settings, services, industries */
  collection: string;
  /** Запись внутри раздела: home, contacts, 01-issledovanie-rynka */
  entry: string;
  /** Что именно правится — показывается при наведении */
  label: string;
  /** 'corner' — в углу блока, 'inline' — в потоке текста */
  placement?: 'corner' | 'inline';
}

const { collection, entry, label, placement = 'corner' } = Astro.props;

const href = asset(`/admin/#/collections/${collection}/entries/${entry}`);
---

<a
  class:list={['edit-btn', `edit-btn--${placement}`]}
  href={href}
  title={`Редактировать: ${label}`}
  aria-label={`Редактировать: ${label}`}
  target="_blank"
  rel="noopener"
>
  <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
    <path
      d="M11.5 1.5l3 3L5 14H2v-3l9.5-9.5z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linejoin="round"
    />
  </svg>
  <span class="edit-btn__label">{label}</span>
</a>
