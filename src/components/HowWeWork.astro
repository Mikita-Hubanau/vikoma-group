---
interface Props { eyebrow: string; title: string; steps: { title: string; text: string }[]; }
const { title, steps } = Astro.props;
---
<section class="section how-we-work"><div class="container"><h2>{title}</h2><ol class="steps__list">{steps.map((step,i) => <li class="step"><span class="step__num" aria-hidden="true">{String(i+1).padStart(2,'0')}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>)}</ol></div></section>
<style>
 .steps__list { display:grid; grid-template-columns:minmax(0,1fr); gap:2rem; list-style:none; padding:0; margin:2.5rem 0 0; }
 .step { display:grid; grid-template-columns:2.5rem minmax(0,1fr); gap:1.5rem; border-top:1px solid var(--line-strong); padding-top:1.5rem; }
 .step__num { font-family:var(--font-serif); font-size:1.6rem; color:var(--accent); }
 .step h3 { font-size:var(--text-lg); margin-bottom:.75rem; }
 .step p { font-size:var(--text-sm); max-width:45ch; }
 @media(min-width:52rem) { .steps__list { grid-template-columns:repeat(2,minmax(0,1fr)); gap:2.5rem 4rem; } }
</style>
