---
// «Как мы работаем» — четыре шага.
// Вдоль шагов идёт линия, которая заполняется акцентным цветом
// по мере прокрутки блока. Это делает браузер, без JavaScript.
import SectionHead from './SectionHead.astro';

interface Props {
  eyebrow: string;
  title: string;
  steps: { title: string; text: string }[];
}

const { eyebrow, title, steps } = Astro.props;
---

<section class="section section--paper2">
  <div class="container">
    <SectionHead eyebrow={eyebrow} title={title} width="24ch" />

    <div class="steps">
      <div class="steps__track" aria-hidden="true">
        <div class="steps__progress"></div>
      </div>

      <ol class="steps__list stagger">
        {
          steps.map((step, i) => (
            <li class="step">
              <span class="step__num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="step__title">{step.title}</h3>
              <p class="step__text">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .steps {
    position: relative;
  }

  /* ── Линия-направляющая ──────────────────────────────────── */
  .steps__track {
    position: absolute;
    background: var(--line-strong);
    /* на телефоне линия вертикальная, слева от шагов */
    left: 7px;
    top: 6px;
    bottom: 6px;
    width: 1px;
  }

  .steps__progress {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: top;
  }

  .steps__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-6);
  }

  .step {
    position: relative;
    padding-left: var(--space-6);
  }

  /* точка на линии напротив каждого шага */
  .step::before {
    content: '';
    position: absolute;
    left: 3px;
    top: 7px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--paper-2);
    border: 1px solid var(--line-strong);
  }

  .step__num {
    display: block;
    font-family: var(--font-serif);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: var(--space-2);
  }

  .step__title {
    margin-bottom: var(--space-2);
  }

  .step__text {
    color: var(--muted);
    font-size: var(--text-sm);
    max-width: 32ch;
  }

  @keyframes fill-line-y {
    to {
      transform: scaleY(1);
    }
  }

  @keyframes fill-line-x {
    to {
      transform: scaleX(1);
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .steps__progress {
        animation: fill-line-y linear both;
        animation-timeline: view();
        animation-range: entry 40% cover 75%;
      }
    }
  }

  /* Если браузер так не умеет или человек отключил анимации —
     линия просто закрашена целиком. */
  @supports not (animation-timeline: view()) {
    .steps__progress {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .steps__progress {
      transform: none;
    }
  }

  /* ── От планшета: шаги в строку, линия горизонтальная ────── */
  @media (min-width: 52rem) {
    .steps__track {
      left: 0;
      right: 0;
      top: 7px;
      bottom: auto;
      width: auto;
      height: 1px;
    }

    .steps__progress {
      transform: scaleX(0);
      transform-origin: left;
      animation-name: fill-line-x;
    }

    .steps__list {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-5);
    }

    .step {
      padding-left: 0;
      padding-top: var(--space-6);
    }

    .step::before {
      left: 0;
      top: 3px;
    }
  }

  @media (min-width: 52rem) and (prefers-reduced-motion: reduce) {
    .steps__progress {
      transform: none;
    }
  }

  @media (min-width: 52rem) {
    @supports not (animation-timeline: view()) {
      .steps__progress {
        transform: none;
      }
    }
  }
</style>
