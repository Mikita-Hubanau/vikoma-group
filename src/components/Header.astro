---
import { defaultLocale, type Locale } from '../i18n/config';
import { useUI } from '../i18n/ui';
import { navOrder, type RouteKey } from '../i18n/routes';
import { href } from '../lib/url';
import LanguageSwitcher from './LanguageSwitcher.astro';
interface Props { locale?: Locale; page?: RouteKey; }
const { locale = defaultLocale, page = 'home' } = Astro.props;
const t = useUI(locale);
---
<header class="site-header">
 <div class="container site-header__inner">
  <a class="logo" href={href('home', locale)} aria-label={`Vikub Group — ${t.nav.home}`}><span class="logo__name">Vikub<span class="logo__dot">.</span></span><span class="logo__sub">Group</span></a>
  <nav class="nav" aria-label={t.primaryNavigation}><ul class="nav__list">{navOrder.map((key) => <li><a class="nav__link" href={href(key, locale)} aria-current={page === key ? 'page' : undefined}>{t.nav[key]}</a></li>)}</ul></nav>
  <div class="site-header__lang"><LanguageSwitcher locale={locale} page={page} /></div>
  <a class="btn btn--primary site-header__cta" href={href('contacts', locale)}>{t.discussProject}</a>
 </div>
</header>
<style>
 .site-header { background:var(--paper); border-bottom:1px solid var(--line); }
 .site-header__inner { display:grid; grid-template-columns:1fr auto; grid-template-areas:'logo lang' 'nav nav'; align-items:center; gap:.75rem 1rem; padding-block:1rem; }
 .logo { grid-area:logo; display:inline-flex; align-items:baseline; gap:.4rem; line-height:1; width:fit-content; }
 .logo__name { font-family:var(--font-serif); font-size:1.8rem; color:var(--ink); letter-spacing:-.04em; }
 .logo__dot { color:var(--accent); }
 .logo__sub { font-size:.58rem; letter-spacing:.2em; font-weight:600; text-transform:uppercase; }
 .site-header__lang { grid-area:lang; }
 .nav { grid-area:nav; min-width:0; }
 .nav__list { display:flex; flex-wrap:wrap; align-items:center; list-style:none; padding:0; gap:0 1.3rem; }
 .nav__link { display:block; min-height:44px; padding-block:.65rem; font-size:var(--text-sm); color:var(--body); border-bottom:1px solid transparent; }
 .nav__link:hover,.nav__link[aria-current=page] { color:var(--accent); border-color:var(--accent); }
 .site-header__cta { display:none; grid-area:cta; white-space:nowrap; }
 @media(min-width:40rem) { .site-header__inner { grid-template-columns:1fr auto auto; grid-template-areas:'logo lang cta' 'nav nav nav'; } .site-header__cta { display:inline-flex; font-size:var(--text-xs); } }
 @media(min-width:70rem) {
  .site-header { position:sticky; top:0; z-index:50; background:color-mix(in srgb,var(--paper) 96%,transparent); backdrop-filter:blur(10px); }
  .site-header__inner { grid-template-columns:auto 1fr auto auto; grid-template-areas:'logo nav lang cta'; gap:1.5rem; }
  .nav__list { justify-content:center; gap:0 1.3rem; }
 }
</style>
