---
import { defaultLocale, type Locale } from '../i18n/config';
import { useUI } from '../i18n/ui';
import { href } from '../lib/url';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const t = useUI(locale);

// Какая страница открыта сейчас — чтобы подсветить пункт меню
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (path: string) => href(path, locale).replace(/\/+$/, '') === current;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="logo" href={href('/', locale)} aria-label={t.home}>
      <span class="logo__name">Vikoma</span>
      <span class="logo__sub">Group</span>
    </a>

    <nav class="nav" aria-label="Основная навигация">
      <ul class="nav__list">
        {
          t.nav.map((item) => (
            <li>
              <a
                class="nav__link"
                href={href(item.path, locale)}
                aria-current={isCurrent(item.path) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="btn btn--primary site-header__cta" href={href('/kontakty/', locale)}>
      {t.discussProject}
    </a>
  </div>
</header>

<style>
  /* На телефоне шапка обычная и уезжает вверх при прокрутке:
     закреплённая в две строки съедала бы четверть экрана. */
  .site-header {
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: auto auto;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    padding-block: var(--space-3);
  }

  /* ── Логотип ─────────────────────────────────────────────── */
  .logo {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45em;
    line-height: 1;
  }

  .logo__name {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .logo__sub {
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ── Меню ────────────────────────────────────────────────── */
  .nav {
    grid-column: 1 / -1;
    grid-row: 2;
    /* если пунктов станет больше и они не влезут — строка прокрутится */
    overflow-x: auto;
    scrollbar-width: none;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
  }

  .nav::-webkit-scrollbar {
    display: none;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    list-style: none;
    padding: 0;
    margin: 0;
    white-space: nowrap;
  }

  .nav__link {
    display: block;
    font-size: var(--text-sm);
    color: var(--body);
    padding-block: var(--space-2);
    border-bottom: 1px solid transparent;
    transition: color var(--transition), border-color var(--transition);
  }

  .nav__link:hover {
    color: var(--ink);
  }

  .nav__link[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }

  /* ── Кнопка в шапке ──────────────────────────────────────── */
  .site-header__cta {
    justify-self: end;
    padding: 0.6em 1.1em;
    font-size: var(--text-xs);
    min-height: 38px;
  }

  /* ── Начиная с планшета всё выстраивается в одну строку ──── */
  @media (min-width: 62rem) {
    /* В одну строку шапка занимает мало места — можно закрепить,
       чтобы кнопка «Обсудить проект» всегда была под рукой. */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: color-mix(in srgb, var(--paper) 92%, transparent);
      backdrop-filter: saturate(180%) blur(10px);
    }

    .site-header__inner {
      grid-template-columns: auto 1fr auto;
      padding-block: var(--space-4);
    }

    .nav {
      grid-column: 2;
      grid-row: 1;
      overflow: visible;
      margin-inline: 0;
      padding-inline: 0;
    }

    .nav__list {
      justify-content: center;
      gap: var(--space-6);
    }

    .site-header__cta {
      font-size: var(--text-sm);
      padding: 0.7em 1.4em;
      min-height: 42px;
    }
  }
</style>
