---
// Шапка внутренней страницы: заголовок и вводный абзац.
import EditButton from './edit/EditButton.astro';

interface Props {
  title: string;
  compact?: boolean;
  lead?: string;
  /** Какую запись открыть по кнопке правки */
  edit?: { collection: string; entry: string; label: string };
}

const { title, lead, edit, compact = false } = Astro.props;
---

<section class:list={["page-header", "edit-anchor", compact && "page-header--compact", !lead && "page-header--no-lead"]}>
  {edit && <EditButton collection={edit.collection} entry={edit.entry} label={edit.label} />}
  <div class="container">
    <h1>{title}</h1>
    {lead && <p class="lead page-header__lead">{lead}</p>}
  </div>
</section>

<style>
  .page-header {
    padding-block: clamp(2.75rem, 1.8rem + 5vw, 6rem) clamp(2rem, 1.5rem + 3vw, 3.5rem);
    border-bottom: 1px solid var(--line);
  }

  .page-header h1 {
    max-width: 16ch;
  }

  .page-header__lead {
    margin-top: var(--space-5);
  }
</style>
