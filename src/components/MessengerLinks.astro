---

<ul class:list={['messengers', `messengers--${variant}`]}>
  {
    messengers.map((m) => (
      <li>
        <a class="messenger" href={m.href} rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d={icons[m.type]} fill="currentColor" />
          </svg>
          <span>{m.label}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .messengers {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .messenger {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    min-height: 44px;
    padding: 0.6em 1.1em;
    font-size: var(--text-sm);
    font-weight: 500;
    border-radius: var(--radius);
    border: 1px solid var(--line-strong);
    color: var(--ink);
    transition: background-color var(--transition), color var(--transition),
      border-color var(--transition);
  }

  .messenger svg {
    width: 1.05em;
    height: 1.05em;
    flex: none;
  }

  .messenger:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .messengers--outline .messenger {
    color: var(--on-dark);
    border-color: rgba(241, 236, 227, 0.28);
  }

  .messengers--outline .messenger:hover {
    background: var(--paper);
    border-color: var(--paper);
    color: var(--ink);
  }
</style>
