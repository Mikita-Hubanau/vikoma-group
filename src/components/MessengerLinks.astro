---
// Кнопки мессенджеров. Список и адреса берутся из settings.json,
// поэтому поменять ник в Telegram можно без правки вёрстки.
import { defaultLocale, type Locale } from '../i18n/config';
import { getSettings } from '../lib/content';

interface Props {
  locale?: Locale;
  /** 'solid' — тёмные кнопки на светлом, 'outline' — контурные */
  variant?: 'solid' | 'outline';
}

const { locale = defaultLocale, variant = 'solid' } = Astro.props;
const { messengers } = await getSettings(locale);

