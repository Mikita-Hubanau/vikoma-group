---
// ЛОГОТИПЫ ПАРТНЁРОВ ИЛИ КЛИЕНТОВ.
//
// Логотипы приглушены и выравниваются по цвету, чтобы пёстрая стена
// не разваливала страницу. При наведении конкретный логотип оживает.
//
// Что нужно: файлы SVG или PNG на прозрачном фоне.
// Важно: перед публикацией убедитесь, что партнёры не против.
import { media } from '../../lib/url';

interface Props {
  title?: string;
  items: { name: string; src?: string; href?: string }[];
  /** true — оставить цвет логотипов как есть */
  colored?: boolean;
}

const { title, items, colored = false } = Astro.props;
---

{title && <p class="logos__title">{title}</p>}

<ul class:list={['logos', colored && 'logos--colored', 'stagger']}>
  {
    items.map((item) => {
      const inner = item.src ? (
        <img src={media(item.src)} alt={item.name} loading="lazy" />
      ) : (
        <span class="logos__stub">{item.name}</span>
      );
      return (
        <li class="logos__item">
          {item.href ? (
            <a href={item.href} rel="noopener" target="_blank">
              {inner}
            </a>
          ) : (
            inner
          )}
        </li>
      );
    })
  }
</ul>

<style>
  .logos__title {
    margin-bottom: var(--space-5);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .logos {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .logos__item {
    display: grid;
    place-items: center;
    min-height: 6.5rem;
    padding: var(--space-4);
    background: var(--paper);
  }

  .logos__item img {
    max-height: 2.5rem;
    width: auto;
    /* приглушаем, чтобы стена логотипов не пестрила */
    filter: grayscale(1);
    opacity: 0.55;
    transition: filter var(--transition), opacity var(--transition);
  }

  .logos__item:hover img {
    filter: grayscale(0);
    opacity: 1;
  }

  .logos--colored .logos__item img {
    filter: none;
    opacity: 1;
  }

  /* заглушка, пока файлов логотипов нет */
  .logos__stub {
    font-family: var(--font-serif);
    font-size: var(--text-md);
    color: var(--line-strong);
    letter-spacing: 0.02em;
    transition: color var(--transition);
  }

  .logos__item:hover .logos__stub {
    color: var(--muted);
  }

  @media (min-width: 40rem) {
    .logos {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 62rem) {
    .logos {
      grid-template-columns: repeat(5, 1fr);
    }
  }
</style>
