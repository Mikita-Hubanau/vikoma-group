---
// ФОТО С ПОДПИСЬЮ.
// Самый простой медиа-блок: один снимок и текст под ним.
// Годится внутри статьи, на странице услуги, в описании отрасли.
import MediaPlaceholder from './MediaPlaceholder.astro';
import Photo from './Photo.astro';

interface Props {
  src?: string;
  alt?: string;
  caption?: string;
  /** '16/9' — панорама, '4/3' — обычное, '3/4' — вертикальное */
  ratio?: string;
  hint?: string;
  /** true — фото шире колонки текста, выходит за её края */
  wide?: boolean;
}

const { src, alt = '', caption, ratio = '16/9', hint, wide = false } = Astro.props;
---

<figure class:list={['fig', wide && 'fig--wide', 'reveal']}>
  <div class="fig__media" style={`--ratio: ${ratio}`}>
    {
      src ? (
        <Photo src={src} alt={alt} sizes="(min-width: 74rem) 68rem, 92vw" />
      ) : (
        <MediaPlaceholder ratio={ratio} hint={hint} />
      )
    }
  </div>
  {caption && <figcaption class="fig__caption">{caption}</figcaption>}
</figure>

<style>
  .fig {
    margin: 0;
  }

  .fig__media {
    overflow: hidden;
    background: var(--paper-2);
  }

  /* Место под фото отводится заранее, по заданным пропорциям:
     иначе страница дёргается, пока снимок грузится. */
  .fig__media :global(img) {
    width: 100%;
    aspect-ratio: var(--ratio, 16 / 9);
    object-fit: cover;
    display: block;
  }

  .fig__caption {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--muted);
    max-width: 48ch;
  }

  /* широкий вариант: снимок вылезает за колонку текста */
  @media (min-width: 62rem) {
    .fig--wide {
      margin-inline: calc(var(--space-8) * -1);
    }
  }
</style>
