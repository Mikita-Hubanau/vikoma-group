---
// Заглушка вместо фотографии или видео.
//
// Показывает пропорции будущего снимка и подсказку, что именно искать.
// Когда появится настоящее фото, у блока просто задаётся src — заглушка
// исчезает сама, вёрстку менять не нужно.
interface Props {
  /** Пропорции: '16/9', '4/3', '3/4', '1/1' */
  ratio?: string;
  /** Что за снимок сюда нужен */
  hint?: string;
  /** Подпись в углу: ФОТО, ВИДЕО, ЛОГОТИП */
  kind?: string;
}

const { ratio = '4/3', hint, kind = 'Фото' } = Astro.props;
---

<div class="ph" style={`--ratio: ${ratio}`}>
  <span class="ph__kind">{kind}</span>
  {hint && <span class="ph__hint">{hint}</span>}
</div>

<style>
  .ph {
    position: relative;
    aspect-ratio: var(--ratio);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-2);
    padding: var(--space-4);
    background: var(--paper-2);
    /* диагональная штриховка — сразу видно, что это временно */
    background-image: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 7px,
      rgba(16, 24, 32, 0.045) 7px,
      rgba(16, 24, 32, 0.045) 8px
    );
    overflow: hidden;
  }

  .ph__kind {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .ph__hint {
    font-size: var(--text-xs);
    line-height: 1.45;
    color: var(--muted);
    max-width: 34ch;
  }
</style>
