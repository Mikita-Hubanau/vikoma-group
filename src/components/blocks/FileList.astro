---
// ФАЙЛЫ ДЛЯ СКАЧИВАНИЯ.
//
// Каталог, прайс, сертификат, презентация. Формат и вес показываем
// сразу: человек должен понимать, что откроется и сколько весит,
// до того как нажмёт — особенно с телефона.
interface Props {
  title?: string;
  items: {
    name: string;
    href?: string;
    /** PDF, XLSX, ZIP */
    format: string;
    /** «2,4 МБ» */
    size?: string;
    note?: string;
  }[];
}

const { title, items } = Astro.props;
---

{title && <p class="files__title">{title}</p>}

<ul class="files stagger">
  {
    items.map((item) => {
      const Tag = item.href ? 'a' : 'span';
      return (
        <li class="files__item">
          <Tag class="file" href={item.href} download>
            <span class="file__format">{item.format}</span>
            <span class="file__body">
              <span class="file__name">{item.name}</span>
              {item.note && <span class="file__note">{item.note}</span>}
            </span>
            {item.size && <span class="file__size">{item.size}</span>}
            <span class="file__icon" aria-hidden="true">
              <svg viewBox="0 0 16 16" width="15" height="15">
                <path
                  d="M8 1v9m0 0L4.5 6.5M8 10l3.5-3.5M2 13h12"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
          </Tag>
        </li>
      );
    })
  }
</ul>

<style>
  .files__title {
    margin-bottom: var(--space-4);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .files {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--line);
    max-width: 46rem;
  }

  .files__item {
    border-bottom: 1px solid var(--line);
  }

  .file {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-4);
    min-height: 44px;
    color: var(--ink);
    transition: color var(--transition);
  }

  .file__format {
    flex: none;
    width: 3.4rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  .file__body {
    flex: 1;
    min-width: 0;
  }

  .file__name {
    display: block;
  }

  .file__note {
    display: block;
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .file__size {
    flex: none;
    font-size: var(--text-xs);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .file__icon {
    flex: none;
    color: var(--line-strong);
    transition: color var(--transition), transform var(--transition);
  }

  a.file:hover {
    color: var(--accent);
  }

  a.file:hover .file__icon {
    color: var(--accent);
    transform: translateY(2px);
  }
</style>
