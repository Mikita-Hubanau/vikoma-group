---
// ТАБЛИЦА.
//
// Условия поставки, сравнение вариантов, технические параметры.
// На узком экране таблицы обычно ломаются — здесь она превращается
// в набор карточек: каждая строка отдельно, с подписями полей.
interface Props {
  caption?: string;
  columns: string[];
  rows: string[][];
}

const { caption, columns, rows } = Astro.props;
---

<div class="table-wrap reveal">
  <table class="table">
    {caption && <caption class="table__caption">{caption}</caption>}
    <thead>
      <tr>
        {columns.map((c) => <th scope="col">{c}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            {row.map((cell, i) => (
              <td data-label={columns[i]}>{cell}</td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .table__caption {
    text-align: left;
    margin-bottom: var(--space-4);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .table th {
    text-align: left;
    font-weight: 600;
    color: var(--ink);
    padding: var(--space-3) var(--space-4) var(--space-3) 0;
    border-bottom: 1px solid var(--line-strong);
  }

  .table td {
    padding: var(--space-4) var(--space-4) var(--space-4) 0;
    border-bottom: 1px solid var(--line);
    color: var(--body);
    vertical-align: top;
  }

  .table tbody tr {
    transition: background-color var(--transition);
  }

  .table tbody tr:hover {
    background: color-mix(in srgb, var(--accent) 4%, transparent);
  }

  /* ── Телефон: строки превращаются в карточки ─────────────── */
  @media (max-width: 47.99rem) {
    .table thead {
      /* заголовки не нужны: подписи переезжают в ячейки */
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .table tbody tr {
      display: block;
      padding-block: var(--space-4);
      border-bottom: 1px solid var(--line-strong);
    }

    .table td {
      display: grid;
      grid-template-columns: 9rem 1fr;
      gap: var(--space-3);
      padding: var(--space-2) 0;
      border: 0;
    }

    .table td::before {
      content: attr(data-label);
      font-size: var(--text-xs);
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
    }
  }

  @media (min-width: 48rem) {
    .table-wrap {
      overflow-x: auto;
    }
  }
</style>
