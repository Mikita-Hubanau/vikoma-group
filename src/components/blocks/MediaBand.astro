---
// ШИРОКОЕ ФОТО ВО ВСЮ ШИРИНУ С ТЕКСТОМ ПОВЕРХ.
// Сильный приём — использовать не чаще одного-двух раз на страницу.
// Требует хорошего горизонтального снимка со «спокойным» местом под текст.
//
// Фото затемняется, иначе белый текст на светлых участках теряется.
import MediaPlaceholder from './MediaPlaceholder.astro';
import Photo from './Photo.astro';

interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  src?: string;
  alt?: string;
  hint?: string;
  /** Высота полосы: 'short' | 'tall' */
  size?: 'short' | 'tall';
}

const { eyebrow, title, text, src, alt = '', hint, size = 'short' } = Astro.props;
---

<section class:list={['band', `band--${size}`]}>
  <div class="band__media">
    {
      src ? (
        <Photo src={src} alt={alt} sizes="100vw" />
      ) : (
        <div class="band__placeholder">
          <MediaPlaceholder ratio="21/9" hint={hint} />
        </div>
      )
    }
  </div>

  <div class="band__veil" aria-hidden="true"></div>

  <div class="container band__body reveal">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 class="band__title">{title}</h2>
    {text && <p class="band__text">{text}</p>}
  </div>
</section>

<style>
  .band {
    position: relative;
    display: grid;
    align-items: end;
    isolation: isolate;
    overflow: hidden;
    min-height: 22rem;
  }

  .band--tall {
    min-height: 32rem;
  }

  .band__media,
  .band__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .band__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .band__placeholder {
    height: 100%;
  }

  .band__placeholder :global(.ph) {
    height: 100%;
    aspect-ratio: auto;
  }

  /* затемнение снизу — чтобы текст читался на любом снимке */
  .band__veil {
    background: linear-gradient(
      to top,
      rgba(16, 24, 32, 0.82) 0%,
      rgba(16, 24, 32, 0.45) 45%,
      rgba(16, 24, 32, 0.1) 100%
    );
  }

  .band__body {
    padding-block: var(--space-7);
  }

  .band__title {
    color: var(--on-dark);
    max-width: 18ch;
  }

  .band__text {
    margin-top: var(--space-4);
    color: var(--on-dark-muted);
    max-width: var(--measure);
  }

  .band .eyebrow {
    color: var(--accent-light);
  }
</style>
