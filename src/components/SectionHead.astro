---
// Шапка смыслового блока: мелкий подзаголовок и крупный заголовок.
interface Props {
  eyebrow: string;
  title: string;
  /** Ширина заголовка в символах — чтобы переносился красиво */
  width?: string;
}

const { eyebrow, title, width = '20ch' } = Astro.props;
---

<div class="section-head reveal">
  <p class="eyebrow">{eyebrow}</p>
  <h2 style={`max-width: ${width}`}>{title}</h2>
</div>

<style>
  .section-head {
    margin-bottom: var(--space-8);
  }
</style>
