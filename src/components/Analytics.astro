---
import type { Locale } from '../i18n/config';
import { analyticsText } from '../i18n/analytics';
import { getIntegrations } from '../lib/integrations';
import { asset } from '../lib/url';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const { googleAnalyticsId } = getIntegrations();
const t = analyticsText[locale];
---
{googleAnalyticsId && <aside class="analytics-banner" data-analytics-banner data-measurement-id={googleAnalyticsId} data-base-path={import.meta.env.BASE_URL} hidden aria-labelledby="analytics-title">
 <h2 id="analytics-title">{t.title}</h2><p>{t.text}</p>
 <div class="analytics-banner__actions"><button type="button" class="btn btn--ghost" data-analytics-reject>{t.reject}</button><button type="button" class="btn btn--ghost" data-analytics-accept>{t.accept}</button></div>
 <a class="link" href="#privacy" data-privacy-open aria-haspopup="dialog" aria-controls="privacy">{t.privacy}</a>
</aside>}
{googleAnalyticsId && <script is:inline type="module" src={asset('/scripts/analytics.js')}></script>}
<style>
 .analytics-banner { position:fixed; left:1rem; right:1rem; bottom:1rem; z-index:100; max-width:42rem; padding:1.5rem; margin-inline:auto; color:var(--body); background:var(--paper); border:1px solid var(--line-strong); box-shadow:0 8px 40px #10182025; max-height:calc(100dvh - 2rem); overflow-y:auto; }
 .analytics-banner h2 { font-size:1.5rem; margin-bottom:.75rem; }
 .analytics-banner p { font-size:var(--text-sm); line-height:1.7; }
 .analytics-banner__actions { display:flex; flex-wrap:wrap; gap:.75rem; margin-top:1.25rem; }
 .analytics-banner__actions button { flex:1; min-width:10rem; }
 .analytics-banner>.link { display:inline-block; font-size:var(--text-xs); margin-top:1rem; }
</style>
