---
import type { Locale } from '../i18n/config';
import { getPage } from '../lib/content';
import { href } from '../lib/url';
import ArrowRight from './ArrowRight.astro';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const { data } = await getPage('homePage', locale);
---
<section class="section section--dark grain contact-block">
  <div class="container contact-block__inner">
    <div><h2>{data.contact.title}</h2><p class="lead">{data.contact.text}</p></div>
    <a class="btn btn--primary" href={href('contacts', locale)}>{data.contact.label}<ArrowRight /></a>
  </div>
</section>
<style>
 .contact-block__inner { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:2rem 4rem; }
 .contact-block__inner .lead { margin-top:1.5rem; max-width:42rem; }
 .contact-block__inner .btn { flex-shrink:0; }
</style>
