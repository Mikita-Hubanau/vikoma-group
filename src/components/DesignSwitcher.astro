---
import type { Locale } from '../i18n/config';
import { designIds, designSettings, designLabels } from '../lib/design';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = designLabels[locale];
const wireframes: Record<string, number[][]> = {
 signature: [[6,1,16,3],[9,6,10,2],[3,11,22,6]],
 balance: [[1,1,12,4],[1,7,10,2],[1,12,9,4],[17,1,10,15]],
 editorial: [[1,1,4,3],[8,1,19,4],[8,8,9,2],[8,12,9,4],[20,8,7,8]],
 atlas: [[1,1,14,15],[18,1,9,4],[18,8,9,2],[18,13,9,3]],
 panorama: [[1,1,26,4],[1,9,15,7],[20,9,7,2],[20,14,7,2]],
};
---
<div class="design-switcher" data-design-switcher>
 <div class="design-switcher__buttons" role="group" aria-label={t.label}>
  {designIds.map((id, i) => <button type="button" class="design-switcher__button" data-design-choice={id} data-design-name={t.names[i]} aria-label={`${String(i + 1).padStart(2, '0')} · ${t.names[i]} — ${t.descriptions[i]}`} title={`${t.names[i]} — ${t.descriptions[i]}`} aria-pressed={id === designSettings.defaultDesign ? 'true' : 'false'}><svg class="design-switcher__wireframe" viewBox="0 0 28 18" width="28" height="18" aria-hidden="true" focusable="false">{wireframes[id].map(([x,y,w,h]) => <rect x={x} y={y} width={w} height={h} />)}</svg><span>{String(i + 1).padStart(2, '0')}</span></button>)}
 </div>
 <p class="design-switcher__caption"><span>{t.label}</span><span data-design-current aria-live="polite" aria-atomic="true">{t.names[designIds.indexOf(designSettings.defaultDesign)]}</span></p>
</div>
<style>
 .design-switcher { width:244px; max-width:100%; }
 .design-switcher__buttons { display:grid; grid-template-columns:repeat(5,1fr); gap:1px; border:1px solid var(--line-strong); background:var(--line-strong); }
 .design-switcher__button { padding:0; min-width:0; min-height:52px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:5px; border:0; background:var(--paper); color:var(--body); cursor:pointer; font:600 .72rem/1 var(--font-sans); font-variant-numeric:tabular-nums; letter-spacing:.04em; position:relative; }
 .design-switcher__button:hover { background:var(--paper-2); color:var(--accent); }
 .design-switcher__button[aria-pressed='true'] { background:var(--ink); color:var(--on-dark); }
 .design-switcher__wireframe { fill:currentColor; opacity:.65; flex-shrink:0; }
 .design-switcher__button[aria-pressed='true']::after { content:''; position:absolute; height:2px; background:var(--accent-light); bottom:3px; width:12px; left:calc(50% - 6px); }
 .design-switcher__caption { display:flex; justify-content:space-between; gap:.5rem; margin-top:.35rem; font-size:.65rem; line-height:1.3; color:var(--muted); }
 .design-switcher__caption [data-design-current] { color:var(--ink); font-weight:600; }
</style>
