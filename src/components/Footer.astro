---
// Подвал намеренно короткий: телефоны, почта и мессенджеры уже стоят
// в блоке контактов прямо над ним — на каждой странице. Дублировать
// их ещё раз значит удлинять страницу без пользы.
import { defaultLocale, type Locale } from '../i18n/config';
import { useUI } from '../i18n/ui';
import { getSettings } from '../lib/content';
import { href } from '../lib/url';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const t = useUI(locale);
const settings = await getSettings(locale);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a class="logo" href={href('/', locale)}>
          <span class="logo__name">Vikoma</span>
          <span class="logo__sub">Group</span>
        </a>
        <p class="site-footer__tagline">{settings.company.tagline}</p>
      </div>

      <nav class="site-footer__col" aria-label="Разделы сайта">
        <h2 class="site-footer__heading">Разделы</h2>
        <ul class="site-footer__list">
          <li><a class="site-footer__link" href={href('/', locale)}>{t.home}</a></li>
          {
            t.nav.map((item) => (
              <li>
                <a class="site-footer__link" href={href(item.path, locale)}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="site-footer__col">
        <h2 class="site-footer__heading">{t.offices}</h2>
        <ul class="site-footer__list">
          {
            settings.offices.map((office) => (
              <li>
                <span class="site-footer__city">{office.city}</span>
                <span class="site-footer__note">{office.address}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>© {year} {settings.company.name}. {t.copyright}.</p>
      <a class="site-footer__link" href={`mailto:${settings.email}`}>{settings.email}</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    background: var(--ink);
    color: var(--on-dark-muted);
    /* тонкая линия отделяет подвал от тёмного блока контактов над ним */
    border-top: 1px solid rgba(241, 236, 227, 0.12);
    padding-block: var(--space-7) var(--space-5);
    font-size: var(--text-sm);
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-6);
  }

  .site-footer__tagline {
    margin-top: var(--space-3);
    max-width: 22rem;
    color: var(--on-dark-muted);
  }

  .logo {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45em;
    line-height: 1;
  }

  .logo__name {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 500;
    color: var(--on-dark);
  }

  .logo__sub {
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--on-dark-muted);
  }

  .site-footer__heading {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-dark);
    margin-bottom: var(--space-4);
  }

  .site-footer__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }

  .site-footer__link {
    color: var(--on-dark-muted);
    transition: color var(--transition);
  }

  .site-footer__link:hover {
    color: var(--on-dark);
  }

  .site-footer__city {
    display: block;
    color: var(--on-dark);
  }

  .site-footer__note {
    display: block;
    font-size: var(--text-xs);
    color: #767e88;
  }

  .site-footer__bottom {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid rgba(241, 236, 227, 0.12);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: var(--text-xs);
  }

  @media (min-width: 40rem) {
    .site-footer__grid {
      grid-template-columns: 1.6fr 1fr 1fr;
      gap: var(--space-6);
    }
  }
</style>
