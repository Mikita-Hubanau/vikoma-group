---
import { defaultLocale, type Locale } from '../i18n/config';
import { useUI } from '../i18n/ui';
import { getSettings } from '../lib/content';
import { getIntegrations } from '../lib/integrations';
import { asset, href } from '../lib/url';
import { navOrder } from '../i18n/routes';
import SocialLinks from './SocialLinks.astro';
interface Props { locale?: Locale; analyticsEnabled?: boolean; }
const { locale = defaultLocale, analyticsEnabled = true } = Astro.props;
const t = useUI(locale);
const settings = await getSettings(locale);
const email = settings.email || settings.offices.find((o) => o.email)?.email;
const phones = settings.phones.length ? settings.phones : settings.offices.filter((o) => o.tel && o.phone).map((o) => ({ tel:o.tel, display:o.phone, label:o.note }));
const { googleAnalyticsId } = getIntegrations();
---
<footer class="site-footer">
 <div class="container">
  <div class="site-footer__grid">
   <div class="site-footer__identity"><a class="site-footer__brand" href={href('home', locale)} aria-label={`VIKUB — ${t.nav.home}`}><img src={asset('/brand/vikub-on-dark.svg')} alt="VIKUB" width="1705" height="374" loading="lazy" decoding="async" /></a><p class="site-footer__tagline" lang="en">{settings.company.tagline}</p></div>
   <nav aria-label={t.sections}><h2 class="site-footer__heading">{t.sections}</h2><ul class="site-footer__list">{navOrder.map((key) => <li><a href={href(key, locale)}>{t.nav[key]}</a></li>)}</ul></nav>
   <div class="site-footer__reach"><h2 class="site-footer__heading">{t.nav.contacts}</h2><div class="site-footer__contacts">
     <span>{t.email}</span>{email ? <a href={`mailto:${email}`}>{email}</a> : <span class="site-footer__pending">{t.unavailable}</span>}
     <span>{t.phone}</span>{phones.length ? phones.map((p) => <a href={`tel:${p.tel}`}>{p.display}<small> · {p.label}</small></a>) : <span class="site-footer__pending">{t.unavailable}</span>}
   </div><div class="site-footer__socials"><SocialLinks locale={locale} /></div></div>
  </div>
  <div class="site-footer__bottom"><p>© 2026 {settings.company.name}. {t.copyright}.</p></div>
  <div class="site-footer__privacy"><a href={`${href('contacts', locale)}#privacy`}>{t.privacy}</a>{googleAnalyticsId && analyticsEnabled && <button type="button" data-analytics-settings>{t.privacySettings}</button>}</div>
 </div>
</footer>
<style>
 .site-footer { margin-top:auto; padding-block:3.5rem 1.5rem; background:var(--ink-deep); color:var(--on-dark-muted); border-top:1px solid #ffffff1c; font-size:var(--text-sm); }
 .site-footer__grid { display:grid; gap:2.5rem; }
 .site-footer__identity,.site-footer__reach { min-width:0; }
 .site-footer__brand { display:inline-flex; align-items:center; min-height:44px; max-width:100%; }
 .site-footer__brand img { display:block; width:196px; max-width:100%; height:auto; }
 .site-footer__socials { margin-top:1.25rem; }
 .site-footer__tagline { margin-top:1rem; max-width:26rem; font-size:var(--text-sm); letter-spacing:.045em; color:var(--on-dark-muted); }
 .site-footer__heading { font-family:var(--font-sans); font-size:var(--text-xs); font-weight:600; color:var(--on-dark); text-transform:uppercase; letter-spacing:.13em; margin-bottom:1rem; }
 .site-footer__list { padding:0; list-style:none; display:grid; gap:.5rem; }
 .site-footer a:hover,.site-footer button:hover { color:var(--on-dark); }
 .site-footer__contacts { display:grid; gap:.45rem; overflow-wrap:anywhere; }
 .site-footer__contacts>span:not(.site-footer__pending) { color:var(--on-dark); margin-top:.35rem; }
 .site-footer__pending { font-size:var(--text-xs); }
 .site-footer__bottom { margin-top:3rem; padding-top:1.5rem; border-top:1px solid #ffffff1c; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:1rem; font-size:var(--text-xs); }
 .site-footer__privacy { display:flex; flex-wrap:wrap; gap:.75rem 1.5rem; margin-top:.75rem; font-size:var(--text-xs); }
 .site-footer__privacy button { font:inherit; color:inherit; background:none; border:0; padding:0; cursor:pointer; }
 .site-footer__privacy a,.site-footer__privacy button { min-height:36px; display:inline-flex; align-items:center; }
 .site-footer__tools { display:none; flex-wrap:wrap; gap:1.5rem; margin-top:1rem; font-size:var(--text-xs); }
 :global(html.edit-mode) .site-footer__tools { display:flex; }
 @media(min-width:48rem) { .site-footer__grid { grid-template-columns:1.7fr 1fr 1.3fr; gap:3rem; } }
</style>
