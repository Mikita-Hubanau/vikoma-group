---
import { getSettings } from '../lib/content';
import type { Locale } from '../i18n/config';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const { partners } = await getSettings(locale);
---
<ul class="partner-grid">
  {partners.map((partner, index) => <li class="partner-detail" id={`partner-${partner.id}`}>
    <span class="partner-detail__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
    <div class="partner-detail__body"><h3>{partner.href ? <a class="link" href={partner.href} target="_blank" rel="noopener noreferrer">{partner.name}</a> : partner.name}</h3><p>{partner.description}</p></div>
  </li>)}
</ul>
<style>
 .partner-grid { list-style:none; padding:0; margin:0; display:grid; gap:1.5rem; }
 .partner-detail { display:grid; grid-template-columns:1.5rem minmax(0,1fr); align-content:start; gap:1rem; padding-block:1.75rem; border-top:1px solid var(--line-strong); min-width:0; }
 .partner-detail__number { color:var(--accent); font-size:var(--text-xs); font-variant-numeric:tabular-nums; padding-top:.25rem; }
 .partner-detail__body { min-width:0; }
 .partner-detail h3 { font-family:var(--font-sans); font-size:var(--text-lg); font-weight:550; line-height:1.35; overflow-wrap:anywhere; }
 .partner-detail p { margin-top:1rem; max-width:48rem; font-size:var(--text-sm); line-height:1.85; }
 @media(min-width:52rem) { .partner-grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:3rem; } .partner-detail { gap:1.25rem; } }
</style>
