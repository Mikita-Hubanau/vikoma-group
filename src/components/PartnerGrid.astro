---
import { getSettings } from '../lib/content';
import type { Locale } from '../i18n/config';
import { findMediaUrl } from '../lib/images';
import Icon from './Icon.astro';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const { partners } = await getSettings(locale);
---
<ul class="partner-grid">
  {partners.map((partner) => {
    const logo = findMediaUrl(partner.logo);
    return <li class="partner-detail" id={`partner-${partner.id}`}>
      <div class="partner-detail__mark">{logo ? <img src={logo} alt="" width="160" height="64" loading="lazy" /> : <Icon name={partner.icon} size={32} />}</div>
      <div><h3>{partner.href ? <a class="link" href={partner.href} target="_blank" rel="noopener noreferrer">{partner.name}</a> : partner.name}</h3><p>{partner.description}</p></div>
    </li>;
  })}
</ul>
<style>
 .partner-grid { list-style:none; padding:0; display:grid; gap:0; }
 .partner-detail { display:grid; grid-template-columns:3rem 1fr; gap:1.5rem; padding-block:2rem; border-top:1px solid var(--line); }
 .partner-detail__mark { color:var(--accent); }
 .partner-detail img { object-fit:contain; width:100%; height:auto; }
 .partner-detail p { margin-top:.75rem; max-width:48rem; }
 .partner-detail h3 { max-width:45rem; }
 @media(min-width:52rem) { .partner-detail { grid-template-columns:8rem 1fr; gap:3rem; } }
</style>
