---
import { getSettings } from '../lib/content';
import { findMediaUrl } from '../lib/images';
import type { Locale } from '../i18n/config';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const { partners } = await getSettings(locale);
---
<ul class="partner-grid">
 {partners.map((partner) => {
  const logo = findMediaUrl(partner.logo);
  return <li class="partner-detail" id={`partner-${partner.id}`}><a class="partner-detail__link" href={partner.href} target="_blank" rel="noopener noreferrer">
   {logo ? <div class="partner-detail__logo"><img src={logo} alt={partner.name} width="240" height="100" loading="lazy" decoding="async" /></div> : <div class="partner-detail__placeholder" aria-hidden="true">{partner.shortName}</div>}
   <h3>{partner.name}<span aria-hidden="true"> ↗</span></h3>
  </a><p>{partner.description}</p></li>;
 })}
</ul>
<style>
 .partner-grid { list-style:none; padding:0; margin:0; display:grid; gap:2rem; }
 .partner-detail { border-top:1px solid var(--line-strong); padding-top:1.75rem; min-width:0; }
 .partner-detail__link { display:block; width:fit-content; max-width:100%; }
 .partner-detail__link:hover h3 { color:var(--accent); }
 .partner-detail__logo,.partner-detail__placeholder { width:100%; height:100px; max-width:260px; margin-bottom:1.25rem; display:flex; align-items:center; }
 .partner-detail__logo img { width:240px; max-width:100%; height:100px; object-fit:contain; object-position:left center; }
 .partner-detail__placeholder { font-family:var(--font-sans); font-size:1.6rem; font-weight:600; color:var(--ink); line-height:1.3; }
 .partner-detail h3 { font-family:var(--font-sans); font-size:var(--text-md); font-weight:500; }
 .partner-detail p { margin-top:1rem; font-size:var(--text-sm); line-height:1.85; max-width:48rem; }
 @media(min-width:42rem) { .partner-grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:3rem; } }
</style>
