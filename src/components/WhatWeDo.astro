---
import SectionHead from './SectionHead.astro';
import EditButton from './edit/EditButton.astro';
import Icon from './Icon.astro';
import type { Locale } from '../i18n/config';
import { href } from '../lib/url';
interface Props { locale: Locale; eyebrow: string; title: string; cards: { icon: string; title: string; text: string; anchor: string }[]; }
const { locale, eyebrow, title, cards } = Astro.props;
---
<section class="section home-services edit-anchor">
 <EditButton collection="pages" entry="home" label="Что мы делаем" />
 <div class="container"><SectionHead eyebrow={eyebrow} title={title} />
  <ul class="service-cards">{cards.map((card, i) => <li class="service-card"><div class="service-card__top"><Icon name={card.icon} size={32} /><span>{String(i+1).padStart(2,'0')}</span></div><h3><a href={`${href('services', locale)}#${card.anchor}`}>{card.title}</a></h3><p>{card.text}</p></li>)}</ul>
 </div>
</section>
<style>
 .service-cards { display:grid; list-style:none; padding:0; margin:0; border-top:1px solid var(--line); }
 .service-card { padding:2rem 0; border-bottom:1px solid var(--line); min-width:0; }
 .service-card__top { display:flex; justify-content:space-between; align-items:center; color:var(--accent); margin-bottom:1.5rem; }
 .service-card__top span { color:var(--muted); font-size:var(--text-xs); font-variant-numeric:tabular-nums; }
 .service-card h3 { margin-bottom:1rem; font-size:1.4rem; }
 .service-card h3 a:hover { color:var(--accent); }
 .service-card p { font-size:var(--text-sm); max-width:35ch; }
 @media(min-width:42rem) { .service-cards { grid-template-columns:repeat(2,minmax(0,1fr)); column-gap:2rem; } }
 @media(min-width:66rem) { .service-cards { grid-template-columns:repeat(4,minmax(0,1fr)); column-gap:2rem; } }
</style>
