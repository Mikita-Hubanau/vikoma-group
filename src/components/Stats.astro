---
import EditButton from './edit/EditButton.astro';
interface Props { eyebrow: string; items: { value: string; suffix: string; label: string; kind: 'number' | 'text' }[]; }
const { eyebrow, items } = Astro.props;
---
<section class="section section--tight edit-anchor">
 <EditButton collection="pages" entry="home" label="Почему мы" />
 <div class="container"><p class="eyebrow">{eyebrow}</p><ul class="stats">{items.map((item) => <li><p class:list={['stat__value',item.kind === 'text' && 'stat__value--text']}>{item.value}{item.suffix && <span> {item.suffix}</span>}</p><p class="stat__label">{item.label}</p></li>)}</ul></div>
</section>
<style>
 .stats { display:grid; gap:2rem; padding:2rem 0 0; list-style:none; border-top:1px solid var(--line); }
 .stats li { display:flex; flex-direction:column; gap:1rem; }
 .stat__value { font-family:var(--font-serif); font-size:clamp(3rem,5vw,4.75rem); color:var(--ink); line-height:1.1; letter-spacing:-.03em; }
 .stat__value span { font-family:var(--font-sans); font-size:1rem; letter-spacing:0; color:var(--accent); }
 .stat__value--text { font-size:clamp(1.6rem,2.5vw,2.1rem); max-width:12ch; line-height:1.15; }
 .stat__label { font-size:var(--text-sm); max-width:24ch; }
 @media(min-width:38rem) { .stats { grid-template-columns:repeat(2,minmax(0,1fr)); } }
 @media(min-width:62rem) { .stats { grid-template-columns:repeat(4,minmax(0,1fr)); } .stat__value { min-height:5.25rem; display:flex; flex-wrap:wrap; align-items:baseline; gap:.5rem; } }
</style>
