---
// Переключатель языков.
// Показывается только если языков больше одного — список задаётся
// в src/i18n/config.ts. Ведёт на ту же самую страницу на другом языке,
// а не на главную: адрес берётся из src/i18n/routes.ts.
import {
  enabledLocales,
  localeName,
  localeFullName,
  type Locale,
} from '../i18n/config';
import { useUI } from '../i18n/ui';
import { href } from '../lib/url';
import type { RouteKey } from '../i18n/routes';

interface Props {
  locale: Locale;
  /** Какая страница открыта — чтобы переключение вело на неё же */
  page: RouteKey;
}

const { locale, page } = Astro.props;
const t = useUI(locale);
---

{
  enabledLocales.length > 1 && (
    <nav class="lang" aria-label={t.language}>
      <ul class="lang__list">
        {enabledLocales.map((code) => (
          <li>
            <a
              class="lang__item"
              href={href(page, code)}
              hreflang={code}
              lang={code}
              title={localeFullName[code]}
              aria-current={code === locale ? 'true' : undefined}
            >
              {localeName[code]}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
 .lang__list { display:flex; list-style:none; padding:3px; margin:0; border:1px solid var(--line-strong); background:var(--paper-2); }
 .lang__item { display:flex; align-items:center; justify-content:center; min-width:36px; min-height:40px; padding:.4rem; font-size:.7rem; font-weight:600; letter-spacing:.05em; color:var(--body); }
 .lang__item:hover { color:var(--accent); }
 .lang__item[aria-current='true'] { color:var(--paper); background:var(--ink); }
 @media(min-width:40rem) { .lang__item { min-width:40px; } }
</style>
