---
// Первый экран главной страницы.
// Заголовок появляется построчно, рядом открывается карта со странами,
// на которых работает компания. Флагов намеренно нет — только очертания.
import type { Locale } from '../i18n/config';
import type { RouteKey } from '../i18n/routes';
import { useUI } from '../i18n/ui';
import { href } from '../lib/url';
import CountriesMap from './CountriesMap.astro';
import EditButton from './edit/EditButton.astro';

interface Props {
  locale: Locale;
  eyebrow: string;
  titleLines: string[];
  lead: string;
  cta: { label: string; page: RouteKey };
  map: { countries: { id: string; label: string }[] };
}

const { locale, eyebrow, titleLines, lead, cta, map } = Astro.props;
const t = useUI(locale);
---

<section class="hero edit-anchor">
  <EditButton collection="pages" entry="home" label="Первый экран" />
  <div class="container hero__inner">
    <div class="hero__text">
      <p class="eyebrow enter" style="--delay: 80ms">{eyebrow}</p>

      <h1 class="hero__title">
        {
          titleLines.map((line, i) => (
            <span class="hero__line enter" style={`--delay: ${180 + i * 110}ms`}>
              {line}
            </span>
          ))
        }
      </h1>

      <p
        class="hero__lead enter"
        style={`--delay: ${240 + titleLines.length * 110}ms`}
      >
        {lead}
      </p>

      <div
        class="hero__actions enter"
        style={`--delay: ${340 + titleLines.length * 110}ms`}
      >
        <a class="btn btn--primary" href={href(cta.page, locale)}>{cta.label}</a>
        <a class="btn btn--ghost" href={href('services', locale)}>{t.allServices}</a>
      </div>
    </div>

    <div class="hero__figure enter" style="--delay: 420ms">
      <CountriesMap countries={map.countries} />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 1.8rem + 7vw, 8rem) clamp(3rem, 2rem + 6vw, 7rem);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .hero__inner {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  .hero__title {
    /* строки заголовка — отдельные блоки, чтобы появляться по очереди */
    display: flex;
    flex-direction: column;
  }

  .hero__line {
    display: block;
  }

  .hero__lead {
    margin-top: var(--space-6);
    max-width: var(--measure);
    font-size: var(--text-md);
    line-height: 1.6;
    color: var(--body);
  }

  .hero__actions {
    margin-top: var(--space-7);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* ── Карта ───────────────────────────────────────────────── */
  .hero__figure {
    max-width: 30rem;
  }

  @media (min-width: 56rem) {
    .hero__inner {
      grid-template-columns: 1.15fr 0.85fr;
      gap: var(--space-9);
    }

    .hero__figure {
      max-width: none;
    }
  }
</style>
