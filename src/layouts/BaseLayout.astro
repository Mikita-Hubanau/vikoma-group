---
// Общая «обёртка» всех страниц: голова документа, шапка, подвал.
// Каждая страница передаёт сюда свой заголовок и описание для поисковиков.
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';
import '../styles/global.css';
import '../styles/designs.css';
import { designSettings } from '../lib/design';

import Analytics from '../components/Analytics.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { defaultLocale, enabledLocales, htmlLang, ogLocale, type Locale } from '../i18n/config';
import { href } from '../lib/url';
import type { RouteKey } from '../i18n/routes';
import { getSettings } from '../lib/content';
import { asset } from '../lib/url';
import { findMediaUrl } from '../lib/images';
import { useUI } from '../i18n/ui';

interface Props {
  /** Заголовок вкладки и результата в поиске */
  title: string;
  /** Описание для поисковиков и превью в мессенджерах */
  description: string;
  /** Картинка превью, если для страницы задана своя */
  ogImage?: string;
  locale?: Locale;
  /** Какая это страница — для подсветки меню и переключателя языков */
  page?: RouteKey;
  /** true — закрыть страницу от поисковиков (служебные страницы) */
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage,
  locale = defaultLocale,
  page = 'home',
  noindex = false,
} = Astro.props;

const settings = await getSettings(locale);
const t = useUI(locale);

// Полный адрес текущей страницы — нужен поисковикам и соцсетям
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();

// Подсказка поисковикам, что у страницы есть версии на других языках.
// Каждая публичная страница имеет три эквивалентные языковые версии.
const alternates = enabledLocales.map((code) => ({
  code,
  url: new URL(href(page, code), Astro.site ?? Astro.url).toString(),
}));
const previewImage = ogImage ? (/^https:\/\//.test(ogImage) ? ogImage : findMediaUrl(ogImage) || asset(ogImage)) : asset('/brand/vikub-social.png');
const ogImageUrl = previewImage ? new URL(previewImage, Astro.site ?? Astro.url).toString() : undefined;
const organization = JSON.stringify({
  '@context':'https://schema.org', '@type':'Organization',
  name:settings.company.name, url:new URL(href('home', locale), Astro.site ?? Astro.url).toString(),
  logo:new URL(asset('/brand/vikub.svg'), Astro.site ?? Astro.url).toString(),
  slogan:settings.company.tagline,
  ...(settings.email ? { email:settings.email } : {}),
  ...(settings.socials.some((s) => s.href) ? { sameAs:settings.socials.filter((s) => s.href).map((s) => s.href) } : {}),
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html id="vikub-site" lang={htmlLang[locale]} data-design={designSettings.defaultDesign}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {
      !noindex && alternates.length > 1 && (
        <>
          {alternates.map((alt) => (
            <link rel="alternate" hreflang={htmlLang[alt.code]} href={alt.url} />
          ))}
          {/* какую версию показать, если язык посетителя не совпал ни с одной */}
          <link
            rel="alternate"
            hreflang="x-default"
            href={new URL(href(page, defaultLocale), Astro.site ?? Astro.url).toString()}
          />
        </>
      )
    }

    <!-- Превью при отправке ссылки в мессенджер или соцсеть -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={settings.company.name} />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:alt" content="VIKUB — Italy meets Eurasia" />}
    {!ogImage && <><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /></>}

    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <link rel="icon" href={asset('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={asset('/apple-touch-icon.png')} sizes="180x180" />
    <link rel="sitemap" href={asset('/sitemap-index.xml')} />

    {!noindex && <script is:inline type="application/ld+json" set:html={organization}></script>}

    <meta name="theme-color" content="#1a1a1a" />
  </head>

  <body>
    <a class="skip-link" href="#main">{t.skipToContent}</a>
    <Header locale={locale} page={page} />
    <main id="main" tabindex="-1" data-page={page}>
      <slot />
    </main>
    <Footer locale={locale} analyticsEnabled={!noindex} />
    {!noindex && <Analytics locale={locale} />}
    {(page === 'home' || page === 'events') && !noindex && <script is:inline type="module" src={asset('/scripts/event-state.js')}></script>}
  </body>
</html>
