---
// КАТАЛОГ ГОТОВЫХ БЛОКОВ.
//
// Служебная страница для заказчика: посмотреть, из чего можно собирать
// страницы. В меню её нет, от поисковиков закрыта, в карту сайта
// не попадает. Ссылку знаете только вы.
import BaseLayout from '../layouts/BaseLayout.astro';
import BlockDemo from '../components/blocks/BlockDemo.astro';

import MediaFigure from '../components/blocks/MediaFigure.astro';
import MediaSplit from '../components/blocks/MediaSplit.astro';
import MediaBand from '../components/blocks/MediaBand.astro';
import Gallery from '../components/blocks/Gallery.astro';
import VideoPlayer from '../components/blocks/VideoPlayer.astro';
import VideoEmbed from '../components/blocks/VideoEmbed.astro';
import LogoWall from '../components/blocks/LogoWall.astro';
import Quote from '../components/blocks/Quote.astro';
import PrinciplesGrid from '../components/blocks/PrinciplesGrid.astro';
import Timeline from '../components/blocks/Timeline.astro';
import Faq from '../components/blocks/Faq.astro';
import DataTable from '../components/blocks/DataTable.astro';
import FileList from '../components/blocks/FileList.astro';
import CtaBand from '../components/blocks/CtaBand.astro';
import Callout from '../components/blocks/Callout.astro';

import { defaultLocale } from '../i18n/config';

const locale = defaultLocale;

const toc = [
  { id: 'figure', name: 'Фото с подписью' },
  { id: 'split', name: 'Фото и текст рядом' },
  { id: 'band', name: 'Широкое фото с текстом' },
  { id: 'gallery', name: 'Галерея' },
  { id: 'video', name: 'Своё видео' },
  { id: 'embed', name: 'Видео с YouTube' },
  { id: 'logos', name: 'Логотипы партнёров' },
  { id: 'quote', name: 'Отзыв' },
  { id: 'principles', name: 'Сетка принципов' },
  { id: 'timeline', name: 'История по годам' },
  { id: 'faq', name: 'Вопросы и ответы' },
  { id: 'table', name: 'Таблица' },
  { id: 'files', name: 'Файлы для скачивания' },
  { id: 'cta', name: 'Полоса с призывом' },
  { id: 'callout', name: 'Выноска' },
];
---

<BaseLayout
  title="Каталог блоков — Vikoma Group"
  description="Служебная страница: готовые блоки, из которых собираются страницы сайта."
  locale={locale}
  noindex={true}
>
  <section class="intro">
    <div class="container">
      <p class="eyebrow">Служебная страница</p>
      <h1>Каталог блоков</h1>
      <p class="lead">
        Всё, из чего можно собирать страницы. Каждый блок уже работает: так он и
        будет выглядеть на сайте.
      </p>
      <p class="intro__note">
        <strong>Фотографии и видео здесь временные</strong> — свободные снимки из
        стока и ролик Big&nbsp;Buck&nbsp;Bunny (Blender Foundation, лицензия
        CC&nbsp;BY). По теме они не подходят намеренно: их задача — показать
        пропорции, обрезку и поведение блоков, а не содержание. Там, где снимка
        пока нет, стоит заглушка с подсказкой, что искать.
      </p>
      <p class="intro__note">
        Страницы для посетителей на эту не ссылаются, и поисковики её не увидят.
        Посмотрите и скажите, что берём — я соберу из этого нужные страницы.
      </p>

      <nav class="toc" aria-label="Список блоков">
        <ol class="toc__list">
          {
            toc.map((item, i) => (
              <li>
                <a class="toc__link" href={`#${item.id}`}>
                  <span class="toc__num">{String(i + 1).padStart(2, '0')}</span>
                  {item.name}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>
  </section>

  <!-- 01 -->
  <BlockDemo
    id="figure"
    num={1}
    title="Фото с подписью"
    when="Один снимок внутри текста. Самый частый и самый спокойный способ показать производство, продукт или объект."
    needs="Горизонтальный снимок от 1600 пикселей по длинной стороне. Подпись — не описание картинки, а дополнение к ней."
  >
    <MediaFigure
      src="/media/blocks/figure.jpg"
      alt="Демонстрационный снимок"
      ratio="16/9"
      caption="Производственная линия партнёра в Марке. Съёмка перед отгрузкой первой партии."
    />
  </BlockDemo>

  <!-- 02 -->
  <BlockDemo
    id="split"
    num={2}
    title="Фото и текст рядом"
    when="Рабочая лошадка для страниц услуг и отраслей. Если ставить несколько подряд, фото чередуется слева и справа — страница перестаёт быть однообразной."
    needs="Снимок в пропорции 4:3 и абзац текста. Список под текстом необязателен."
  >
    <div class="stack">
      <MediaSplit
        eyebrow="Проверка партнёров"
        title="Смотрим склад до того, как вы поедете"
        text="Выезжаем на площадку сами: смотрим, есть ли реальные мощности, техника и люди. Фотоотчёт и выводы отправляем до вашей первой встречи."
        items={['Выезд на площадку', 'Фотоотчёт', 'Проверка юрлица и финансов']}
        src="/media/blocks/split-1.jpg"
        alt="Демонстрационный снимок"
      />
      <MediaSplit
        reverse
        eyebrow="Логистика"
        title="Документы готовим заранее"
        text="Сертификаты и декларации оформляем до того, как машина выехала. Так партия не стоит на границе, пока кто-то ищет недостающую бумагу."
        src="/media/blocks/split-2.jpg"
        alt="Демонстрационный снимок"
      />
    </div>
  </BlockDemo>

  <!-- 03 -->
  <BlockDemo
    id="band"
    num={3}
    title="Широкое фото с текстом поверх"
    when="Сильный приём — не чаще одного-двух раз на страницу. Хорош как разделитель между разделами или как заставка раздела."
    needs="Качественный горизонтальный снимок с «пустым» местом внизу под текст. Фото затемняется автоматически, иначе белый текст потеряется."
    full={true}
  >
    <MediaBand
      eyebrow="Два рынка"
      title="Работаем там, где принимаются решения"
      text="Офисы в Минске и Фано — не адрес на сайте, а люди, которые в понедельник утром едут на переговоры."
      src="/media/blocks/band.jpg"
      alt="Демонстрационный снимок"
    />
  </BlockDemo>

  <!-- 04 -->
  <BlockDemo
    id="gallery"
    num={4}
    title="Галерея"
    when="Несколько снимков одной темы: производство, склад, выставка, объект. На телефоне листается вбок пальцем, на компьютере — обычная сетка."
    needs="От трёх до девяти снимков одинаковой пропорции. Разнобой по свету и цвету заметен сразу — лучше одна съёмка."
  >
    <Gallery
      columns={3}
      items={[
        { src: '/media/gallery/g1.jpg', caption: 'Производство, Марке' },
        { src: '/media/gallery/g2.jpg', caption: 'Линия розлива' },
        { src: '/media/gallery/g3.jpg', caption: 'Отгрузка' },
        { src: '/media/gallery/g4.jpg', caption: 'Встреча с дистрибьютором' },
        { src: '/media/gallery/g5.jpg', caption: 'Выставка в Минске' },
        { src: '/media/gallery/g6.jpg', caption: 'Первая партия' },
      ]}
    />
  </BlockDemo>

  <!-- 05 -->
  <BlockDemo
    id="video"
    num={5}
    title="Своё видео"
    when="Ролик лежит у нас на сервере. Никаких сторонних сервисов, счётчиков и чужого кода. Файл начинает качаться только когда посетитель нажал «play»."
    needs="Файл .mp4 весом до 15–20 МБ и кадр-обложка. Для ролика длиннее двух минут лучше YouTube — иначе хостинг будет отдавать тяжёлый файл каждому."
  >
    <VideoPlayer
      src="/media/video/demo.mp4"
      poster="/media/blocks/video-poster.jpg"
      caption="Демонстрационный ролик. Big Buck Bunny © Blender Foundation, лицензия CC BY 3.0 — стоит здесь только чтобы показать, как работает проигрыватель."
    />
  </BlockDemo>

  <!-- 06 -->
  <BlockDemo
    id="embed"
    num={6}
    title="Видео с YouTube или Vimeo"
    when="Для длинных роликов. Показываем обложку с кнопкой; настоящий проигрыватель подгружается только после нажатия."
    needs="Ссылка на ролик. Обычная вставка тянет около мегабайта чужого кода на каждой загрузке страницы, даже если видео никто не смотрит, — поэтому сделано через обложку."
  >
    <VideoEmbed hint="Обложка ролика — обычно самый выразительный кадр, а не первый" />
  </BlockDemo>

  <!-- 07 -->
  <BlockDemo
    id="logos"
    num={7}
    title="Логотипы партнёров"
    when="Быстро показывает уровень: с кем работаете. Для B2B часто убедительнее любого текста."
    needs="Файлы SVG или PNG на прозрачном фоне. Логотипы приглушены и оживают при наведении — иначе пёстрая стена разваливает страницу. Перед публикацией стоит спросить разрешение у партнёров."
  >
    <LogoWall
      title="С кем работаем"
      items={[
        { name: 'Partner Uno' },
        { name: 'Secondo' },
        { name: 'Terza SPA' },
        { name: 'Quarta SRL' },
        { name: 'Quinto' },
      ]}
    />
  </BlockDemo>

  <!-- 08 -->
  <BlockDemo
    id="quote"
    num={8}
    title="Отзыв"
    when="После описания услуги или в конце страницы «О компании»."
    needs="Имя, должность и компания. Анонимный отзыв «Иван, предприниматель» доверия не добавляет, скорее наоборот. Фото автора усиливает заметно."
  >
    <div class="two-up">
      <Quote
        text="Мы два года искали дистрибьютора сами и дважды обожглись. Здесь нам сначала показали отчёт, почему один из кандидатов нам не подходит, — и только потом предложили второго."
        author="Marco Bellini"
        role="Export manager"
        company="Bellini Macchine"
      />
      <Quote
        dark
        text="Документы на первую партию собрали за неделю. На таможне вопросов не возникло вообще — для нас это было впервые."
        author="Имя Фамилия"
        role="Директор по закупкам"
        company="Компания"
      />
    </div>
  </BlockDemo>

  <!-- 09 -->
  <BlockDemo
    id="principles"
    num={9}
    title="Сетка принципов"
    when="Короткие тезисы с номерами. Уже стоит на странице «О компании» в блоке «Почему нам можно доверять» — теперь с анимацией."
    needs="От двух до шести пунктов: заголовок в три-четыре слова и абзац. При прокрутке над каждой ячейкой прочерчивается линия и загорается номер."
  >
    <PrinciplesGrid
      items={[
        {
          title: 'Не продаём товар',
          text: 'У нас нет своего склада и своего интереса в конкретной поставке. Мы не заинтересованы навязать вам партнёра.',
        },
        {
          title: 'Проверяем до знакомства',
          text: 'Юридическая и финансовая благонадёжность контрагента проверяется до того, как вы потратите время на встречу.',
        },
        {
          title: 'Два языка, два правовых поля',
          text: 'Переписка, договоры и переговоры идут без переводчика-посредника.',
        },
        {
          title: 'Остаёмся после сделки',
          text: 'Первая поставка — не финал. Мы сопровождаем работу дистрибьютора и дальше.',
        },
      ]}
    />
  </BlockDemo>

  <!-- 10 -->
  <BlockDemo
    id="timeline"
    num={10}
    title="История по годам"
    when="На странице «О компании», если истории есть чем гордиться: открытие офиса, первая поставка, выход в новую страну."
    needs="От четырёх до восьми событий. Линия слева заполняется по мере прокрутки. Меньше четырёх событий — блок выглядит бедно, лучше обычный текст."
  >
    <Timeline
      items={[
        { year: '2018', title: 'Начало работы', text: 'Первые запросы от итальянских производителей оборудования.' },
        { year: '2020', title: 'Офис в Минске', text: 'Своя команда по ВЭД и таможенному оформлению.' },
        { year: '2022', title: 'Представительство в Фано', text: 'Работа с производителями напрямую, без посредников.' },
        { year: '2024', title: '50-й проект', text: 'Пять отраслей, поставки в трёх направлениях.' },
      ]}
    />
  </BlockDemo>

  <!-- 11 -->
  <BlockDemo
    id="faq"
    num={11}
    title="Вопросы и ответы"
    when="Снимает типовые возражения до того, как человек напишет: сроки, оплата, гарантии, минимальный объём."
    needs="От четырёх до восьми пар вопрос-ответ. Раскрывается средствами браузера, без скриптов, — ответы видны поисковикам."
  >
    <Faq
      items={[
        {
          question: 'Сколько стоит первая консультация?',
          answer: 'Ничего. Первый разговор нужен, чтобы понять, есть ли у задачи решение, — за это платить незачем.',
        },
        {
          question: 'Вы берёте процент с оборота?',
          answer: 'Нет. Работаем по фиксированной стоимости этапа. Так у нас нет интереса раздувать объём поставки.',
        },
        {
          question: 'Сколько занимает поиск дистрибьютора?',
          answer: 'От полутора до четырёх месяцев в зависимости от отрасли. Оборудование дольше, продукты питания быстрее.',
        },
        {
          question: 'Работаете ли вы с небольшими компаниями?',
          answer: 'Да. Ограничение не по размеру компании, а по продукту: он должен быть востребован на рынке.',
        },
      ]}
    />
  </BlockDemo>

  <!-- 12 -->
  <BlockDemo
    id="table"
    num={12}
    title="Таблица"
    when="Условия поставки, сравнение вариантов, технические параметры."
    needs="На телефоне таблицы обычно ломаются — здесь каждая строка превращается в карточку с подписями полей. Больше пяти колонок лучше не делать."
  >
    <DataTable
      caption="Что входит в этапы работы"
      columns={['Этап', 'Срок', 'Результат']}
      rows={[
        ['Исследование рынка', '3–4 недели', 'Отчёт с рекомендацией: выходить или нет'],
        ['Поиск партнёров', '6–12 недель', 'Список проверенных компаний и организованные встречи'],
        ['Оформление сделки', '2–4 недели', 'Контракт ВЭД, сертификаты, таможенное оформление'],
        ['Сопровождение', 'Постоянно', 'Контроль работы дистрибьютора'],
      ]}
    />
  </BlockDemo>

  <!-- 13 -->
  <BlockDemo
    id="files"
    num={13}
    title="Файлы для скачивания"
    when="Каталог, прайс, презентация, сертификат."
    needs="Формат и вес показываем сразу: человек должен понимать, что откроется и сколько весит, — особенно с телефона."
  >
    <FileList
      title="Документы"
      items={[
        { name: 'Презентация компании', format: 'PDF', size: '2,4 МБ', note: 'Обновлена в январе' },
        { name: 'Каталог оборудования партнёра', format: 'PDF', size: '11,8 МБ' },
        { name: 'Форма запроса на поставку', format: 'XLSX', size: '84 КБ' },
      ]}
    />
  </BlockDemo>

  <!-- 14 -->
  <BlockDemo
    id="cta"
    num={14}
    title="Полоса с призывом"
    when="В середине длинной страницы — там, где человек дочитал раздел и уже понял, зачем ему писать. Большой блок контактов внизу страницы никуда не девается."
    needs="Одна фраза и одна кнопка. Два варианта: спокойный на светлой подложке и тёмный."
  >
    <div class="stack">
      <CtaBand
        locale={locale}
        title="Не уверены, что продукт пойдёт на рынке?"
        text="Начните с исследования: три недели, и будет понятно, стоит ли вкладываться дальше."
        action={{ label: 'Обсудить проект', page: 'contacts' }}
      />
      <CtaBand
        locale={locale}
        tone="strong"
        title="Тот же блок, тёмный вариант"
        text="Уместен, когда вокруг много светлых блоков и нужна пауза."
        action={{ label: 'Написать нам', page: 'contacts' }}
      />
    </div>
  </BlockDemo>

  <!-- 15 -->
  <BlockDemo
    id="callout"
    num={15}
    title="Выноска"
    when="Короткое важное замечание внутри текста: условие, оговорка, предупреждение о сроках."
    needs="Два-три предложения. Если выносок на странице больше двух, они перестают работать — глаз привыкает."
  >
    <div class="stack">
      <Callout title="Обратите внимание">
        <p>
          Требования к маркировке продуктов питания меняются чаще всего. Проверяйте
          их не раньше чем за месяц до отгрузки — данные полугодовой давности уже
          могут быть недействительны.
        </p>
      </Callout>
      <Callout tone="warn" title="Важно">
        <p>
          Без предварительной сертификации партия может простоять на границе
          несколько недель. Документы готовим до отправки машины.
        </p>
      </Callout>
    </div>
  </BlockDemo>
</BaseLayout>

<style>
  .intro {
    padding-block: clamp(2.5rem, 1.8rem + 4vw, 5rem) var(--space-7);
  }

  .intro__note {
    margin-top: var(--space-4);
    max-width: var(--measure);
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .toc {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }

  .toc__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-2);
  }

  .toc__link {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    padding-block: 0.35em;
    font-size: var(--text-sm);
    color: var(--body);
    transition: color var(--transition);
  }

  .toc__link:hover {
    color: var(--accent);
  }

  .toc__num {
    font-family: var(--font-serif);
    font-size: var(--text-xs);
    color: var(--line-strong);
  }

  /* несколько блоков одного вида подряд */
  .stack {
    display: grid;
    gap: var(--space-7);
  }

  .two-up {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 40rem) {
    .toc__list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-2) var(--space-6);
    }
  }

  @media (min-width: 62rem) {
    .toc__list {
      grid-template-columns: repeat(3, 1fr);
    }

    .two-up {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
    }
  }
</style>
