---
// КАТАЛОГ ГОТОВЫХ БЛОКОВ.
//
// Служебная страница для заказчика: посмотреть, из чего можно собирать
// страницы. В меню её нет, от поисковиков закрыта, в карту сайта
// не попадает. Ссылку знаете только вы.
import BaseLayout from '../layouts/BaseLayout.astro';
import BlockDemo from '../components/blocks/BlockDemo.astro';

import MediaFigure from '../components/blocks/MediaFigure.astro';
import MediaSplit from '../components/blocks/MediaSplit.astro';
import MediaBand from '../components/blocks/MediaBand.astro';
import Gallery from '../components/blocks/Gallery.astro';
import VideoPlayer from '../components/blocks/VideoPlayer.astro';
import VideoEmbed from '../components/blocks/VideoEmbed.astro';
import LogoWall from '../components/blocks/LogoWall.astro';
import Quote from '../components/blocks/Quote.astro';
import PrinciplesGrid from '../components/blocks/PrinciplesGrid.astro';
import Timeline from '../components/blocks/Timeline.astro';
import Faq from '../components/blocks/Faq.astro';
import DataTable from '../components/blocks/DataTable.astro';
import FileList from '../components/blocks/FileList.astro';
import CtaBand from '../components/blocks/CtaBand.astro';
import Callout from '../components/blocks/Callout.astro';

import { defaultLocale } from '../i18n/config';
import { getEntry } from 'astro:content';

const locale = defaultLocale;

// Тексты каталога правятся в редакторе: раздел «Служебное».
// Сами показы блоков остаются в коде — это живые блоки с настройками.
const entry = await getEntry('blocksPage', 'blocks');
if (!entry) throw new Error('Нет файла src/content/system/blocks.json');
const page = entry.data;

// Порядок показов задан здесь; тексты подставляются по id.
const order = [
  'figure', 'split', 'band', 'gallery', 'video', 'embed', 'logos', 'quote',
  'principles', 'timeline', 'faq', 'table', 'files', 'cta', 'callout',
];
const meta = (id: string) => {
  const b = page.blocks.find((x) => x.id === id);
  return {
    title: b?.name ?? id,
    when: b?.when ?? '',
    needs: b?.needs ?? '',
    note: b?.note ?? '',
    num: order.indexOf(id) + 1,
  };
};

---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  locale={locale}
  noindex={true}
>
  <section class="intro">
    <div class="container">
      <p class="eyebrow">Служебная страница</p>
      <h1>{page.title}</h1>
      <p class="lead">{page.lead}</p>
      <p class="intro__note">{page.mediaNote}</p>
      <p class="intro__note">{page.serviceNote}</p>

      <nav class="toc" aria-label="Список блоков">
        <ol class="toc__list">
          {
            order.map((id, i) => (
              <li>
                <a class="toc__link" href={`#${id}`}>
                  <span class="toc__num">{String(i + 1).padStart(2, '0')}</span>
                  {meta(id).title}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>
  </section>

  <!-- 01 -->
  <BlockDemo
    id="figure"
    {...meta('figure')}
  >
    <MediaFigure
      src="/media/blocks/figure.jpg"
      alt="Демонстрационный снимок"
      ratio="16/9"
      caption="Производственная линия партнёра в Марке. Съёмка перед отгрузкой первой партии."
    />
  </BlockDemo>

  <!-- 02 -->
  <BlockDemo
    id="split"
    {...meta('split')}
  >
    <div class="stack">
      <MediaSplit
        eyebrow="Проверка партнёров"
        title="Смотрим склад до того, как вы поедете"
        text="Выезжаем на площадку сами: смотрим, есть ли реальные мощности, техника и люди. Фотоотчёт и выводы отправляем до вашей первой встречи."
        items={['Выезд на площадку', 'Фотоотчёт', 'Проверка юрлица и финансов']}
        src="/media/blocks/split-1.jpg"
        alt="Демонстрационный снимок"
      />
      <MediaSplit
        reverse
        eyebrow="Логистика"
        title="Документы готовим заранее"
        text="Сертификаты и декларации оформляем до того, как машина выехала. Так партия не стоит на границе, пока кто-то ищет недостающую бумагу."
        src="/media/blocks/split-2.jpg"
        alt="Демонстрационный снимок"
      />
    </div>
  </BlockDemo>

  <!-- 03 -->
  <BlockDemo
    id="band"
    {...meta('band')}
    full={true}
  >
    <MediaBand
      eyebrow="Два рынка"
      title="Работаем там, где принимаются решения"
      text="Офисы в Минске и Фано — не адрес на сайте, а люди, которые в понедельник утром едут на переговоры."
      src="/media/blocks/band.jpg"
      alt="Демонстрационный снимок"
    />
  </BlockDemo>

  <!-- 04 -->
  <BlockDemo
    id="gallery"
    {...meta('gallery')}
  >
    <Gallery
      columns={3}
      items={[
        { src: '/media/gallery/g1.jpg', caption: 'Производство, Марке' },
        { src: '/media/gallery/g2.jpg', caption: 'Линия розлива' },
        { src: '/media/gallery/g3.jpg', caption: 'Отгрузка' },
        { src: '/media/gallery/g4.jpg', caption: 'Встреча с дистрибьютором' },
        { src: '/media/gallery/g5.jpg', caption: 'Выставка в Минске' },
        { src: '/media/gallery/g6.jpg', caption: 'Первая партия' },
      ]}
    />
  </BlockDemo>

  <!-- 05 -->
  <BlockDemo
    id="video"
    {...meta('video')}
  >
    <VideoPlayer
      src="/media/video/demo.mp4"
      poster="/media/blocks/video-poster.jpg"
      caption="Демонстрационный ролик. Big Buck Bunny © Blender Foundation, лицензия CC BY 3.0 — стоит здесь только чтобы показать, как работает проигрыватель."
    />
  </BlockDemo>

  <!-- 06 -->
  <BlockDemo
    id="embed"
    {...meta('embed')}
  >
    <VideoEmbed
      videoId={page.youtube.videoId || undefined}
      poster={page.youtube.poster || undefined}
      title={page.youtube.title}
      caption={page.youtube.caption}
      hint="Обложка ролика — обычно самый выразительный кадр, а не первый"
    />
  </BlockDemo>

  <!-- 07 -->
  <BlockDemo
    id="logos"
    {...meta('logos')}
  >
    <LogoWall
      title="С кем работаем"
      items={[
        { name: 'Partner Uno' },
        { name: 'Secondo' },
        { name: 'Terza SPA' },
        { name: 'Quarta SRL' },
        { name: 'Quinto' },
      ]}
    />
  </BlockDemo>

  <!-- 08 -->
  <BlockDemo
    id="quote"
    {...meta('quote')}
  >
    <div class="two-up">
      <Quote
        text="Мы два года искали дистрибьютора сами и дважды обожглись. Здесь нам сначала показали отчёт, почему один из кандидатов нам не подходит, — и только потом предложили второго."
        author="Marco Bellini"
        role="Export manager"
        company="Bellini Macchine"
      />
      <Quote
        dark
        text="Документы на первую партию собрали за неделю. На таможне вопросов не возникло вообще — для нас это было впервые."
        author="Имя Фамилия"
        role="Директор по закупкам"
        company="Компания"
      />
    </div>
  </BlockDemo>

  <!-- 09 -->
  <BlockDemo
    id="principles"
    {...meta('principles')}
  >
    <PrinciplesGrid
      items={[
        {
          title: 'Не продаём товар',
          text: 'У нас нет своего склада и своего интереса в конкретной поставке. Мы не заинтересованы навязать вам партнёра.',
        },
        {
          title: 'Проверяем до знакомства',
          text: 'Юридическая и финансовая благонадёжность контрагента проверяется до того, как вы потратите время на встречу.',
        },
        {
          title: 'Два языка, два правовых поля',
          text: 'Переписка, договоры и переговоры идут без переводчика-посредника.',
        },
        {
          title: 'Остаёмся после сделки',
          text: 'Первая поставка — не финал. Мы сопровождаем работу дистрибьютора и дальше.',
        },
      ]}
    />
  </BlockDemo>

  <!-- 10 -->
  <BlockDemo
    id="timeline"
    {...meta('timeline')}
  >
    <Timeline
      items={[
        { year: '2018', title: 'Начало работы', text: 'Первые запросы от итальянских производителей оборудования.' },
        { year: '2020', title: 'Офис в Минске', text: 'Своя команда по ВЭД и таможенному оформлению.' },
        { year: '2022', title: 'Представительство в Фано', text: 'Работа с производителями напрямую, без посредников.' },
        { year: '2024', title: '50-й проект', text: 'Пять отраслей, поставки в трёх направлениях.' },
      ]}
    />
  </BlockDemo>

  <!-- 11 -->
  <BlockDemo
    id="faq"
    {...meta('faq')}
  >
    <Faq
      items={[
        {
          question: 'Сколько стоит первая консультация?',
          answer: 'Ничего. Первый разговор нужен, чтобы понять, есть ли у задачи решение, — за это платить незачем.',
        },
        {
          question: 'Вы берёте процент с оборота?',
          answer: 'Нет. Работаем по фиксированной стоимости этапа. Так у нас нет интереса раздувать объём поставки.',
        },
        {
          question: 'Сколько занимает поиск дистрибьютора?',
          answer: 'От полутора до четырёх месяцев в зависимости от отрасли. Оборудование дольше, продукты питания быстрее.',
        },
        {
          question: 'Работаете ли вы с небольшими компаниями?',
          answer: 'Да. Ограничение не по размеру компании, а по продукту: он должен быть востребован на рынке.',
        },
      ]}
    />
  </BlockDemo>

  <!-- 12 -->
  <BlockDemo
    id="table"
    {...meta('table')}
  >
    <DataTable
      caption="Что входит в этапы работы"
      columns={['Этап', 'Срок', 'Результат']}
      rows={[
        ['Исследование рынка', '3–4 недели', 'Отчёт с рекомендацией: выходить или нет'],
        ['Поиск партнёров', '6–12 недель', 'Список проверенных компаний и организованные встречи'],
        ['Оформление сделки', '2–4 недели', 'Контракт ВЭД, сертификаты, таможенное оформление'],
        ['Сопровождение', 'Постоянно', 'Контроль работы дистрибьютора'],
      ]}
    />
  </BlockDemo>

  <!-- 13 -->
  <BlockDemo
    id="files"
    {...meta('files')}
  >
    <FileList
      title="Документы"
      items={[
        { name: 'Презентация компании', format: 'PDF', size: '2,4 МБ', note: 'Обновлена в январе' },
        { name: 'Каталог оборудования партнёра', format: 'PDF', size: '11,8 МБ' },
        { name: 'Форма запроса на поставку', format: 'XLSX', size: '84 КБ' },
      ]}
    />
  </BlockDemo>

  <!-- 14 -->
  <BlockDemo
    id="cta"
    {...meta('cta')}
  >
    <div class="stack">
      <CtaBand
        locale={locale}
        title="Не уверены, что продукт пойдёт на рынке?"
        text="Начните с исследования: три недели, и будет понятно, стоит ли вкладываться дальше."
        action={{ label: 'Обсудить проект', page: 'contacts' }}
      />
      <CtaBand
        locale={locale}
        tone="strong"
        title="Тот же блок, тёмный вариант"
        text="Уместен, когда вокруг много светлых блоков и нужна пауза."
        action={{ label: 'Написать нам', page: 'contacts' }}
      />
    </div>
  </BlockDemo>

  <!-- 15 -->
  <BlockDemo
    id="callout"
    {...meta('callout')}
  >
    <div class="stack">
      <Callout title="Обратите внимание">
        <p>
          Требования к маркировке продуктов питания меняются чаще всего. Проверяйте
          их не раньше чем за месяц до отгрузки — данные полугодовой давности уже
          могут быть недействительны.
        </p>
      </Callout>
      <Callout tone="warn" title="Важно">
        <p>
          Без предварительной сертификации партия может простоять на границе
          несколько недель. Документы готовим до отправки машины.
        </p>
      </Callout>
    </div>
  </BlockDemo>
</BaseLayout>

<style>
  .intro {
    padding-block: clamp(2.5rem, 1.8rem + 4vw, 5rem) var(--space-7);
  }

  .intro__note {
    margin-top: var(--space-4);
    max-width: var(--measure);
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .toc {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }

  .toc__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-2);
  }

  .toc__link {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    padding-block: 0.35em;
    font-size: var(--text-sm);
    color: var(--body);
    transition: color var(--transition);
  }

  .toc__link:hover {
    color: var(--accent);
  }

  .toc__num {
    font-family: var(--font-serif);
    font-size: var(--text-xs);
    color: var(--line-strong);
  }

  /* несколько блоков одного вида подряд */
  .stack {
    display: grid;
    gap: var(--space-7);
  }

  .two-up {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 40rem) {
    .toc__list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-2) var(--space-6);
    }
  }

  @media (min-width: 62rem) {
    .toc__list {
      grid-template-columns: repeat(3, 1fr);
    }

    .two-up {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
    }
  }
</style>
