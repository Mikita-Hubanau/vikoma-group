---
// ПОЛНАЯ ЗАПИСЬ СЕМИНАРА 1 ОКТЯБРЯ 2026 ГОДА — ЗАКРЫТАЯ СТРАНИЦА.
//
// Страница живёт по прямой ссылке: в меню её нет, в карте сайта нет,
// от поисковиков закрыта. Адрес с датой — чтобы следующая запись легла
// рядом, а не поверх этой.
//
// Чем отличается от страницы «Мероприятия»: там лежат фрагменты, открытые
// всем, здесь — полная запись для своих, с пометкой о запрете копирования.
// Страница двуязычная без переключателя: запись одна, общая для итальянцев
// и русских, и запрет копирования должен быть понятен обоим — поэтому
// обе строки показываем сразу.
//
// ГДЕ ЛЕЖИТ САМО ВИДЕО
// Не в проекте. Файл загружается на хостинг вручную, в папку
//     public_html/vikub.com/media/webinar-2026-10/
// под именем VIKUB_webinar_10_2026_privat.mp4. Он весит сотни мегабайт,
// поэтому в репозитории его нет и сборка его не трогает. Автодеплой эту
// папку обходит стороной (исключение прописано в .github/workflows/deploy.yml).
// Если когда-нибудь будете заливать сайт «начисто» — папку надо сохранить
// и вернуть на место, иначе запись пропадёт.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPage } from '../lib/content';
import { eventDate } from '../lib/seminar';
import { asset } from '../lib/url';

const BASE = '/media/webinar-2026-10/';
const video = asset(`${BASE}VIKUB_webinar_10_2026_privat.mp4`);
const poster = asset(`${BASE}poster.jpg`);

// Заголовки берём из тех же текстов, что и страница «Мероприятия»:
// поправят название семинара в редакторе — поправится и здесь.
const { data: itPage } = await getPage('eventsPage', 'it');
const { data: ruPage } = await getPage('eventsPage', 'ru');

const meta = `Registrazione del webinar del ${eventDate('it')} · Запись вебинара от ${eventDate('ru')} года`;

const seo = {
  title: 'VIKUB — registrazione del webinar / запись вебинара',
  description: 'Registrazione integrale del webinar VIKUB del 1 ottobre 2026. Ad uso interno.',
};
---

<BaseLayout title={seo.title} description={seo.description} locale="it" noindex={true} bare={true}>
  <div class="wv">
    <header class="wv__top">
      <a class="wv__brand" href={asset('/')} aria-label="VIKUB">
        <img src={asset('/brand/vikub-on-dark.svg')} alt="VIKUB" width="112" height="25" />
      </a>
      <a class="wv__back" href={asset('/')}>Vai al sito · На сайт</a>
    </header>

    <main class="wv__main">
      <h1 class="wv__title">{itPage.title}</h1>
      <p class="wv__title-ru">{ruPage.title}</p>
      <p class="wv__meta">{meta}</p>

      <p class="wv__warning">
        <span>Ad uso interno — vietato copiare e diffondere.</span>
        <span>Для внутреннего пользования — копировать и распространять запрещено.</span>
      </p>

      <div class="wv__screen">
        <video
          class="wv__video"
          src={video}
          poster={poster}
          controls
          playsinline
          preload="metadata"
          controlslist="nodownload"
        ></video>
      </div>
    </main>

    <footer class="wv__foot">
      <a href="mailto:info@vikub.com">info@vikub.com</a>
      <a href="#privacy" data-privacy-open aria-haspopup="dialog" aria-controls="privacy"
        >Trattamento dei dati personali · Обработка персональных данных</a
      >
    </footer>
  </div>
</BaseLayout>

<style>
  .wv {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 1.25rem clamp(1rem, 4vw, 2.5rem) 2rem;
    background: var(--ink);
    color: #f5f5f5;
  }

  .wv__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .wv__brand img {
    display: block;
    height: 25px;
    width: auto;
  }
  .wv__back,
  .wv__foot a {
    color: #b9b4ab;
    font-size: var(--text-sm);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .wv__back:hover,
  .wv__foot a:hover {
    color: #f5f5f5;
    border-bottom-color: #b78c42;
  }

  .wv__main {
    flex: 1;
    width: 100%;
    max-width: 68rem;
    margin-inline: auto;
  }

  .wv__title {
    font-size: clamp(1.4rem, 1.1rem + 1.6vw, 2.1rem);
    line-height: 1.25;
    color: #f5f5f5;
    margin: 0;
  }
  .wv__title-ru {
    margin: 0.5rem 0 0;
    font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.25rem);
    line-height: 1.35;
    color: #b9b4ab;
  }
  .wv__meta {
    margin-top: 0.75rem;
    font-size: var(--text-sm);
    color: #8d949d;
  }

  /* Пометка о запрете копирования: видна сразу, до нажатия на воспроизведение */
  .wv__warning {
    display: grid;
    gap: 0.25rem;
    margin: 1.5rem 0 1rem;
    padding: 0.85rem 1.1rem;
    border: 1px solid #5e4a24;
    border-left: 3px solid #b78c42;
    background: #1b1710;
    color: #e4d8bf;
    font-size: var(--text-sm);
  }

  .wv__screen {
    background: #000;
    border: 1px solid #2c3540;
    overflow: hidden;
  }
  .wv__video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    background: #000;
  }

  .wv__foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    justify-content: center;
    padding-top: 1rem;
    border-top: 1px solid #202a35;
  }

  @media (max-width: 36rem) {
    .wv {
      padding-inline: 0.85rem;
    }
  }
</style>
