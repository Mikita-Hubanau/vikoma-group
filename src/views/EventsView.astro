---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactBlock from '../components/ContactBlock.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Icon from '../components/Icon.astro';
import RegistrationForm from '../components/RegistrationForm.astro';
import type { Locale } from '../i18n/config';
import { getPage } from '../lib/content';
import { getIntegrations } from '../lib/integrations';
import { seminar, seminarEnd, eventDate, eventTime, withDate, eventState } from '../lib/seminar';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const { data: page } = await getPage('eventsPage',locale);
const { registrationUrl, registrationFormEndpoint, contactFormEndpoint } = getIntegrations();
const endpoint = registrationFormEndpoint || contactFormEndpoint;
const state = eventState();
const r = page.registration;
const agenda = page.agenda;
---
<BaseLayout {...page.seo} locale={locale} page="events">
 <PageHeader title={page.title} lead={page.lead} compact />
 <div class="container event-register-cta" data-event-status data-deadline={seminar.registrationDeadline} data-end={seminarEnd}>
  <a class="btn btn--primary" href="#registration" data-registration-link data-event-open hidden={state !== 'open'}>{r.button}<Icon name="arrow" size={18} /></a>
  <span class="event-free">{page.freeLabel}</span>
 </div>
 <section class="section section--tight"><div class="container"><h2 class="visually-hidden">{page.detailsTitle}</h2><dl class="event-facts">
  <div><dt>{page.dateLabel}</dt><dd><time datetime={seminar.startAt}>{eventDate(locale)}</time></dd></div>
  <div><dt>{page.timeLabel}</dt><dd>{eventTime(locale)}<small>{page.timeNote}</small></dd></div>
  <div><dt>{page.formatLabel}</dt><dd>{page.formatValue}</dd></div>
  <div><dt>{page.languageLabel}</dt><dd>{page.languageValue}<small>{page.languageNote}</small></dd></div>
  <div><dt>{page.durationLabel}</dt><dd>{page.durationValue}</dd></div>
 </dl></div></section>
 {/* The supplied repository has no audience copy. Preserve it verbatim if supplied
     through the CMS; do not invent audience statements to fill an empty section. */}
 {page.audience.paragraphs.length > 0 && <section class="section section--tight event-audience"><div class="container"><h2>{page.audience.title}</h2>{page.audience.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div></section>}
 <section class="section section--paper2 event-benefits"><div class="container"><FeatureGrid {...page.benefits} /></div></section>
 <section class="section"><div class="container event-content">
  <div class="event-program"><h2>{page.programTitle}</h2>
   {agenda ? (
    <>
     <p class="program-format">{agenda.format}</p>
     <ol class="program-list">
      {agenda.items.map((item) => (
       <li class="program-item">
        <h3>{item.title}</h3>
        {item.speaker && <p class="program-speaker">{item.speaker}</p>}
        {item.paragraphs.map((paragraph) => <p class="program-description">{paragraph}</p>)}
       </li>
      ))}
     </ol>
     <section class="program-optional" aria-labelledby="program-optional-title">
      <h3 id="program-optional-title">{agenda.optionalTitle}</h3>
      <ul class="dash-list">
       {agenda.optionalItems.map((item) => <li class="program-optional-item">{item}</li>)}
      </ul>
     </section>
    </>
   ) : (
    <>
     <p class="program-bookend">{page.program[0]}</p>
     <div class="program-groups">{page.programGroups.map((group,i) => <section class="program-group"><h3><span aria-hidden="true">{String(i+1).padStart(2,'0')}</span>{group.title}</h3><ul class="dash-list">{group.indices.map((index) => <li>{page.program[index]}</li>)}</ul></section>)}</div>
     <p class="program-bookend">{page.program[page.program.length-1]}</p>
    </>
   )}
   <p class="program-note"><em>{page.programNote}</em></p>
  </div>
  <aside class="registration" id="registration" data-event-status data-deadline={seminar.registrationDeadline} data-end={seminarEnd}>
   <Icon name="calendar" size={36} /><h2>{r.title}</h2><p>{withDate(r.text,eventDate(locale,seminar.registrationDeadline))}</p>
   <div data-event-open hidden={state !== 'open'}>
    <p class="event-free event-free--form">{page.freeLabel}</p>
    <RegistrationForm locale={locale} labels={r} endpoint={endpoint} />
    {registrationUrl && <div class="registration__fallback"><a class="arrow-link" data-registration-link href={registrationUrl} target="_blank" rel="noopener noreferrer">{r.externalButton}<Icon name="arrow" size={18} /></a><p class="registration__note">{r.externalNote}</p></div>}
   </div>
   <p class="notice" data-event-closed hidden={state !== 'closed'}>{r.closed}</p><p class="notice" data-event-ended hidden={state !== 'ended'}>{r.ended}</p>
  </aside>
 </div></section>
 <ContactBlock locale={locale} />
</BaseLayout>
<style>
 .event-register-cta { display:flex; flex-wrap:wrap; align-items:center; gap:1rem 1.5rem; padding-top:1.75rem; }
 .event-free { display:inline-flex; align-items:center; padding:.6rem 1rem; font-size:var(--text-sm); font-weight:500; color:var(--accent); background:var(--accent-soft); border:1px solid var(--accent-light); }
 .event-free--form { margin-top:1.5rem; }
 .event-facts { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:2rem; margin:0; }
 .event-facts>div { min-width:0; border-top:1px solid var(--line); padding-top:1.25rem; }
 .event-facts dt { font-size:var(--text-xs); letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin-bottom:.75rem; }
 .event-facts dd { font-family:var(--font-serif); font-size:1.35rem; color:var(--ink); line-height:1.35; }
 .event-facts small { display:block; margin-top:.5rem; color:var(--body); font-family:var(--font-sans); font-size:var(--text-xs); line-height:1.6; }
 .event-audience p { margin-top:1.25rem; max-width:50rem; }
 .event-content { display:grid; gap:3rem; align-items:start; }
 .event-program { min-width:0; }
 .program-format { margin-top:1.25rem; font-size:var(--text-sm); }
 .program-list { margin:2rem 0 0; padding-inline-start:2rem; list-style:decimal; }
 .program-item { padding:1.5rem 0 1.75rem .35rem; border-top:1px solid var(--line); overflow-wrap:anywhere; }
 .program-item::marker { color:var(--accent); font-size:var(--text-lg); font-weight:500; }
 .program-item h3 { font-size:var(--text-lg); line-height:1.35; }
 .program-speaker { margin-top:.85rem; font-size:var(--text-sm); font-weight:600; color:var(--ink); }
 .program-description { margin-top:.75rem; font-size:var(--text-sm); }
 .program-optional { margin-top:1rem; padding:1.5rem; border-left:2px solid var(--accent-light); background:var(--paper-2); }
 .program-optional h3 { font-family:var(--font-sans); font-size:var(--text-sm); font-weight:600; line-height:1.6; margin-bottom:1rem; }
 .program-optional li { font-size:var(--text-sm); overflow-wrap:anywhere; }
 .program-bookend { margin-block:1.5rem; font-size:var(--text-sm); }
 .program-groups { border-top:1px solid var(--line-strong); }
 .program-group { border-bottom:1px solid var(--line); padding-block:2rem; }
 .program-group h3 { display:flex; gap:1rem; align-items:baseline; font-size:var(--text-lg); margin-bottom:1.25rem; }
 .program-group h3 span { color:var(--accent); font-size:var(--text-md); }
 .program-group li { font-size:var(--text-sm); }
 .program-note { margin-top:1.25rem; font-size:var(--text-sm); color:var(--muted); }
 .registration { border:1px solid var(--line-strong); background:var(--paper); }
 .registration > :global(svg) { color:var(--accent); margin-bottom:1.5rem; }
 .registration h2 { font-size:var(--text-xl); }
 .registration > p { margin-top:1.25rem; }
 .registration__fallback { margin-top:1.75rem; padding-top:1.25rem; border-top:1px solid var(--line); }
 .registration__note { margin-top:1rem; font-size:var(--text-xs); }
 .notice { font-size:var(--text-sm); background:var(--paper-2); padding:1rem; margin-top:1.5rem; border-left:2px solid var(--accent); }
 @media(min-width:52rem) { .event-content { grid-template-columns:minmax(0,1.5fr) minmax(0,1fr); gap:4rem; } }
 @media(min-width:66rem) { .event-facts { grid-template-columns:1.1fr .85fr .7fr 1.4fr .9fr; } }
 @media(max-width:24rem) { .event-facts { grid-template-columns:minmax(0,1fr); } }
</style>
