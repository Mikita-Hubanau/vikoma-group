---
import { render } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import IndustryCard from '../components/IndustryCard.astro';
import ContactBlock from '../components/ContactBlock.astro';
import type { Locale } from '../i18n/config';
import { getList, getPage, byOrder } from '../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { data: page } = await getPage('industriesPage', locale);

const industries = byOrder(await getList('industries', locale));
const items = await Promise.all(
  industries.map(async (entry) => ({
    data: entry.data,
    slug: entry.id.split('/').pop()!,
    Content: (await render(entry)).Content,
  })),
);
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  locale={locale}
  page="industries"
>
  <PageHeader
    title={page.title}
    lead={page.lead}
    edit={{ collection: 'pages', entry: 'industries', label: 'Отрасли — шапка страницы' }}
  />

  <section class="section">
    <div class="container">
      <ul class="industries stagger">
        {
          items.map(({ data, slug, Content }) => (
            <li>
              <IndustryCard
                locale={locale}
                title={data.title}
                summary={data.summary}
                image={data.image}
                imageHint={data.imageHint}
                slug={slug}
              >
                <div class="prose industry-text">
                  <Content />
                </div>
              </IndustryCard>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ContactBlock locale={locale} />
</BaseLayout>

<style>
  .industries {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-8) var(--space-6);
  }

  .industry-text {
    font-size: var(--text-sm);
    color: var(--body);
  }

  @media (min-width: 48rem) {
    .industries {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 68rem) {
    .industries {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
