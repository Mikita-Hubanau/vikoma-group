---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactBlock from '../components/ContactBlock.astro';
import PrinciplesGrid from '../components/blocks/PrinciplesGrid.astro';
import type { Locale } from '../i18n/config';
import { useUI } from '../i18n/ui';
import { getLocalizedEntry } from '../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useUI(locale);
const { data: page } = await getLocalizedEntry('aboutPage', 'pages/about', locale);
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  locale={locale}
  page="about"
>
  <PageHeader title={page.title} lead={page.lead} />

  <!-- История -->
  <section class="section">
    <div class="container">
      <div class="story reveal">
        {
          page.story.map((paragraph, i) => (
            <p class:list={['story__p', i === 0 && 'story__p--first']}>{paragraph}</p>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Почему нам можно доверять -->
  <section class="section section--paper2">
    <div class="container">
      <PrinciplesGrid title={page.approach.title} items={page.approach.items} />
    </div>
  </section>

  <!-- Команда -->
  <section class="section">
    <div class="container">
      <div class="team__head reveal">
        <p class="eyebrow">{t.team}</p>
        <h2>{page.team.title}</h2>
        <p class="team__note">{page.team.note}</p>
      </div>

      <ul class="team stagger">
        {
          page.team.people.map((person) => (
            <li class="person">
              <div class="person__photo">
                {person.photo ? (
                  <img src={person.photo} alt={person.name} loading="lazy" />
                ) : (
                  <span class="person__placeholder">{t.photoPlaceholder}</span>
                )}
              </div>
              <h3 class="person__name">{person.name}</h3>
              <p class="person__role">{person.role}</p>
              <p class="person__about">{person.about}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ContactBlock locale={locale} />
</BaseLayout>

<style>
  /* ── История ─────────────────────────────────────────────── */
  .story {
    max-width: var(--measure);
    display: grid;
    gap: var(--space-5);
  }

  /* первый абзац крупнее — он задаёт тон */
  .story__p--first {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: 1.45;
    color: var(--ink);
  }

  /* ── Команда ─────────────────────────────────────────────── */
  .team__head {
    margin-bottom: var(--space-8);
  }

  .team__note {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .team {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-7) var(--space-6);
  }

  .person__photo {
    position: relative;
    aspect-ratio: 3 / 4;
    margin-bottom: var(--space-4);
    background: var(--paper-2);
    overflow: hidden;
    /* та же штриховка, что и у заглушек фотографий отраслей */
    background-image: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 7px,
      rgba(16, 24, 32, 0.045) 7px,
      rgba(16, 24, 32, 0.045) 8px
    );
  }

  .person__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .person__placeholder {
    position: absolute;
    left: var(--space-4);
    bottom: var(--space-4);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .person__name {
    font-size: var(--text-md);
  }

  .person__role {
    margin-top: var(--space-1);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .person__about {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--muted);
  }

  @media (min-width: 48rem) {
    .team {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
