---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactBlock from '../components/ContactBlock.astro';
import Photo from '../components/blocks/Photo.astro';
import PartnerGrid from '../components/PartnerGrid.astro';
import SectionHead from '../components/SectionHead.astro';
import type { Locale } from '../i18n/config';
import { getPage } from '../lib/content';
import { findImage } from '../lib/images';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const { data: page } = await getPage('aboutPage',locale);
---
<BaseLayout {...page.seo} locale={locale} page="about">
 <PageHeader title={page.title} lead={page.lead} />
 <section class="section section--tight about-intro"><div class="container"><p class="about-subtitle">{page.subtitle}</p></div></section>
 <section class="section section--tight"><div class="container mission"><h2>{page.mission.title}</h2><p>{page.mission.text}</p></div></section>
 <section class="section section--paper2"><div class="container"><h2 class="block-heading">{page.team.title}</h2><ul class="team">{page.team.people.map((person) => <li class="person"><div class="person__identity">{person.photo && findImage(person.photo) ? <div class="person__photo"><Photo src={person.photo} alt={person.name} widths={[200,400]} sizes="200px" /></div> : <div class="person__initials" aria-hidden="true">{person.initials}</div>}<div><h3>{person.name}</h3><p class="person__role">{person.role}</p></div></div><p class="person__about">{person.about}</p></li>)}</ul></div></section>
 <section class="section expert-network"><div class="container expert-network__inner"><div><p class="eyebrow">{page.experts.eyebrow}</p><h2>{page.experts.title}</h2></div><p class="expert-network__text">{page.experts.text}</p></div></section>
 <section class="section section--paper2"><div class="container"><SectionHead {...page.partners} /><PartnerGrid locale={locale} /></div></section>
 <ContactBlock locale={locale} />
</BaseLayout>
<style>
 .about-subtitle { font-family:var(--font-serif); font-size:var(--text-xl); max-width:58rem; color:var(--ink); }
 .mission,.expert-network__inner { display:grid; gap:2rem; }
 .mission p { font-size:var(--text-md); max-width:50rem; }
 .block-heading { margin-bottom:2.5rem; }
 .team { list-style:none; display:grid; gap:1.5rem; padding:0; margin:0; }
 .person { min-width:0; }
 .person__identity { display:flex; gap:1.5rem; margin-bottom:1.5rem; }
 .person__identity h3 { font-size:var(--text-lg); overflow-wrap:anywhere; }
 .person__role { font-size:var(--text-sm); margin-top:.75rem; color:var(--accent); }
 .person__about { font-size:var(--text-sm); }
 .expert-network__text { max-width:48rem; }
 @media(min-width:52rem) { .mission,.expert-network__inner { grid-template-columns:1fr 1.6fr; gap:5rem; } }
</style>
