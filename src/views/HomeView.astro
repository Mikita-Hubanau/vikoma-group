---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import WhatWeDo from '../components/WhatWeDo.astro';
import SectionHead from '../components/SectionHead.astro';
import Stats from '../components/Stats.astro';
import ContactBlock from '../components/ContactBlock.astro';
import EventTeaser from '../components/EventTeaser.astro';
import PartnerGrid from '../components/PartnerGrid.astro';
import ArrowRight from '../components/ArrowRight.astro';
import EditButton from '../components/edit/EditButton.astro';
import type { Locale } from '../i18n/config';
import { getPage } from '../lib/content';
import { href } from '../lib/url';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const { data: page } = await getPage('homePage', locale);
---
<BaseLayout {...page.seo} locale={locale} page="home">
 <Hero locale={locale} {...page.hero} />
 <WhatWeDo locale={locale} {...page.whatWeDo} />
 <section class="section section--paper2 home-about edit-anchor"><EditButton collection="pages" entry="home" label="О нас — кратко" /><div class="container about-summary"><div><SectionHead eyebrow={page.about.eyebrow} title={page.about.title} /><a class="arrow-link" href={href(page.about.cta.page,locale)}>{page.about.cta.label}<ArrowRight /></a></div><div class="about-summary__text">{page.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div></div></section>
 <EventTeaser locale={locale} />
 <Stats {...page.stats} />
 <section class="section section--tight home-partners edit-anchor"><EditButton collection="settings" entry="contacts" label="Партнёры" /><div class="container"><SectionHead {...page.partners} /><PartnerGrid locale={locale} /></div></section>
 <ContactBlock locale={locale} />
</BaseLayout>
<style>
 .about-summary { display:grid; gap:2rem; }
 .about-summary__text { display:grid; gap:1.25rem; max-width:44rem; }
 @media(min-width:52rem) { .about-summary { grid-template-columns:1fr 1.6fr; gap:5rem; } }
</style>
