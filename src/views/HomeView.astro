---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import WhatWeDo from '../components/WhatWeDo.astro';
import SectionHead from '../components/SectionHead.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import ContactBlock from '../components/ContactBlock.astro';
import EventTeaser from '../components/EventTeaser.astro';
import PartnerGrid from '../components/PartnerGrid.astro';
import ArrowRight from '../components/ArrowRight.astro';
import Icon from '../components/Icon.astro';
import type { Locale } from '../i18n/config';
import { getPage } from '../lib/content';
import { href } from '../lib/url';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const { data: page } = await getPage('homePage', locale);
---
<BaseLayout {...page.seo} locale={locale} page="home">
 <Hero locale={locale} {...page.hero} />
 <section class="section home-about"><div class="container about-summary"><div><SectionHead title={page.about.title} /><a class="arrow-link" href={href(page.about.cta.page,locale)}>{page.about.cta.label}<ArrowRight /></a></div><div class="about-summary__text">{page.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div></div></section>
 <ContactBlock locale={locale} />
 <WhatWeDo locale={locale} {...page.whatWeDo} />
 <section class="section home-why"><div class="container"><FeatureGrid {...page.why} /></div></section>
 <section class="section section--paper2 home-belarus"><div class="container belarus-summary"><Icon name="globe" size={38} /><div><h2>{page.belarus.title}</h2><p>{page.belarus.text}</p><a class="arrow-link" href={href('contacts',locale)}>{page.belarus.label}<ArrowRight /></a></div></div></section>
 <EventTeaser locale={locale} />
 <section class="section section--tight home-partners"><div class="container"><SectionHead {...page.partners} /><PartnerGrid locale={locale} /></div></section>
 <ContactBlock locale={locale} />
</BaseLayout>
<style>
 .about-summary { display:grid; gap:2rem; }
 .about-summary__text { display:grid; gap:1.25rem; max-width:44rem; }
 .belarus-summary { display:grid; grid-template-columns:auto minmax(0,1fr); gap:1.5rem 2.5rem; align-items:start; }
 .belarus-summary > :global(svg) { color:var(--accent); margin-top:.35rem; }
 .belarus-summary h2 { font-size:var(--text-xl); }
 .belarus-summary p { margin-block:1.5rem; max-width:48rem; }
 @media(min-width:52rem) { .about-summary { grid-template-columns:1fr 1.6fr; gap:5rem; } }
</style>
