---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactBlock from '../components/ContactBlock.astro';
import PartnerLink from '../components/PartnerLink.astro';
import HowWeWork from '../components/HowWeWork.astro';
import Icon from '../components/Icon.astro';
import type { Locale } from '../i18n/config';
import { getList, getPage, byOrder } from '../lib/content';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const { data: page } = await getPage('servicesPage', locale);
// Historical service files stay in the repository for reference, but are not published.
const services = byOrder((await getList('services', locale)).filter((entry) => !entry.data.archived));
const items = await Promise.all(services.map(async (entry) => ({ data: entry.data, Content: (await render(entry)).Content })));
---
<BaseLayout {...page.seo} locale={locale} page="services">
 <PageHeader title={page.title} lead={page.lead} />
 <section class="section"><div class="container"><ol class="services">
  {items.map(({data,Content},i) => <li class="service" id={data.anchor}>
   <div class="service__aside"><span class="service__num" aria-hidden="true">{String(i+1).padStart(2,'0')}</span><Icon name={data.icon} size={30} /><h2 class="service__title">{data.title}</h2></div>
   <div class="service__body"><div class="prose"><Content /></div>{data.partnerId && <p class="service__partner"><PartnerLink locale={locale} id={data.partnerId} label={data.partner} /></p>}</div>
  </li>)}
 </ol></div></section>
 <section class="section section--paper2 expert-support"><div class="container expert-support__inner"><Icon name="network" size={38} /><div><p class="eyebrow">{page.expertSupport.eyebrow}</p><h2>{page.expertSupport.title}</h2><div class="expert-support__copy">{page.expertSupport.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div></div></div></section>
 <HowWeWork {...page.howWeWork} />
 <ContactBlock locale={locale} />
</BaseLayout>
<style>
 .services { list-style:none; padding:0; margin:0; }
 .service { display:grid; grid-template-columns:minmax(0,1fr); gap:2rem; border:1px solid var(--line); padding:2rem; }
 .service__aside,.service__body { min-width:0; }
 .service__aside > :global(svg) { color:var(--accent); margin-bottom:1.5rem; }
 .service__num { display:block; font-family:var(--font-serif); color:var(--accent); margin-bottom:1.5rem; }
 .service__title { font-size:var(--text-xl); }
 .service__partner { border-top:1px solid var(--line); padding-top:1.5rem; margin-top:2rem; }
 .expert-support__inner { display:grid; grid-template-columns:auto minmax(0,1fr); gap:2rem; max-width:64rem; }
 .expert-support__inner > :global(svg) { color:var(--accent); }
 .expert-support h2 { font-size:var(--text-xl); max-width:35ch; }
 .expert-support__copy { display:grid; gap:1.25rem; margin-top:2rem; }
</style>
